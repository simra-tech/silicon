/bin/bash ../../../libtool  --tag=CC   --mode=compile gcc -DHAVE_CONFIG_H   -I. -I. -I../../../src/include -I../../../src/include  -static -O2 -s -Wall -Wextra -Wmissing-prototypes -Wstrict-prototypes -Wnested-externs -Wold-style-definition -Wredundant-decls -Wconversion -Wno-unused-but-set-variable -std=gnu11 -fopenmp -MT niiter.lo -MD -MP -MF .deps/niiter.Tpo -c -o niiter.lo niiter.c
libtool: compile:  gcc -DHAVE_CONFIG_H -I. -I. -I../../../src/include -I../../../src/include -O2 -s -Wall -Wextra -Wmissing-prototypes -Wstrict-prototypes -Wnested-externs -Wold-style-definition -Wredundant-decls -Wconversion -Wno-unused-but-set-variable -std=gnu11 -fopenmp -MT niiter.lo -MD -MP -MF .deps/niiter.Tpo -c niiter.c -o niiter.o
mv -f .deps/niiter.Tpo .deps/niiter.Plo
