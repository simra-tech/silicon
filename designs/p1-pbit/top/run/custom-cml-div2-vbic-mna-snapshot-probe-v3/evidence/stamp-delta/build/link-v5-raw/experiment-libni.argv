/bin/bash ../../../libtool  --tag=CC   --mode=link gcc -static -O2 -s -Wall -Wextra -Wmissing-prototypes -Wstrict-prototypes -Wnested-externs -Wold-style-definition -Wredundant-decls -Wconversion -Wno-unused-but-set-variable -std=gnu11 -fopenmp   -o libni.la  niaciter.lo nicomcof.lo niconv.lo nidest.lo niditer.lo niinit.lo niinteg.lo niiter.lo niniter.lo nipred.lo nipzmeth.lo nireinit.lo nisenre.lo  -lm   -lstdc++
