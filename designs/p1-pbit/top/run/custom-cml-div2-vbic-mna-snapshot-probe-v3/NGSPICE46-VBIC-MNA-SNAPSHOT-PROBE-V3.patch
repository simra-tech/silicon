+/* ---- [MNA_SNAPSHOT] read-only diagnostic snapshot helper. ----
+ * Declared in ngspice/smpdefs.h. Emits to stderr with %a precision;
+ * synchronous, once-only by the caller; no writes to the matrix, RHS, or
+ * circuit state; no element creation; no arithmetic recomputation (stored
+ * values are emitted as-is). size is the largest valid equation index
+ * (ckt->CKTmaxEqNum - 1): indices 1..size inclusive are emitted and the
+ * same bound validates external row/column identities and vector_expected.
+ * Every BEGIN/END/UNSUPPORTED/ABORT/GUARD record carries the full event
+ * provenance (snapshot id, tnode, iterno, time, mode, backend, phase);
+ * every structurally valid stored entry and every RHS/solution index is
+ * emitted with an explicit finite=0/1 flag and counted observed. The
+ * sparse pre-factor enumeration is TWO-PASS: a read-only validation/count
+ * pass over all safely traversable FirstInCol/NextInCol chains computes
+ * the EXACT full stored-entry count (entries_expected) and records range
+ * guards WITHOUT indexing an invalid map position; if any structural/
+ * range guard fired, NO entry/vector payload is emitted (status=incomplete)
+ * and only a clean pass may perform the second emit pass. Return codes:
+ *   0 = MNA_SNAP_OK        structural completeness (status=complete)
+ *   1 = MNA_SNAP_ARG       NULL/negative argument or size <= 0
+ *   2 = MNA_SNAP_BACKEND   backend_flag != Matrix->CKTkluMODE
+ *   3 = MNA_SNAP_PHASE     phase not exactly prefactor/postsolve/abort
+ *   4 = MNA_SNAP_UNSUP     KLU prefactor unsupported (fail closed)
+ *   5 = MNA_SNAP_STRUCT    sparse structure/map guard
+ *   6 = MNA_SNAP_RANGE     internal/external range guard
+ *   7 = MNA_SNAP_PARTIAL   KLU postsolve vector (status=partial)
+ *   8 = MNA_SNAP_ABORT     keyed iteration abandoned before solve
+ * The sparse branch walks the private MatrixFrame column chains INSIDE
+ * the SMP layer and maps internal indices through
+ * IntToExtRowMap/IntToExtColMap. The KLU pre-factor phase fails closed:
+ * the CSC arrays (KLUmatrixAp/Ai/Ax) are populated only by the
+ * reorder/factor conversion (SMPreorder/SMPluFac KLU branches), so the
+ * pre-factor CSC is uninitialized at the snapshot site, and the
+ * post-conversion external identity passes through node collapsing
+ * (KLUmatrixNodeCollapsingNewToOld). The post-solve solution vector is
+ * available in RHS in both modes (the effective SMPsolve writes the
+ * solution back into RHS). ---- */
+
+#define MNA_SNAP_OK        0
+#define MNA_SNAP_ARG       1
+#define MNA_SNAP_BACKEND   2
+#define MNA_SNAP_PHASE     3
+#define MNA_SNAP_UNSUP     4
+#define MNA_SNAP_STRUCT    5
+#define MNA_SNAP_RANGE     6
+#define MNA_SNAP_PARTIAL   7
+#define MNA_SNAP_ABORT     8
+
+static long long
+SMPsnapshotMNA_emit_vector (double *RHS, int size, const char *tag,
+                            long id, const char *phase)
+{
+    long long observed = 0;
+    int I;
+
+    for (I = 1; I <= size; I++) {
+        /* every index 1..size is structurally valid; non-finite values are
+         * preserved with %a and an explicit finite=0/1 flag */
+        fprintf (stderr, "[MNA_SNAPSHOT_%s] id=%ld phase=%s index=%d value=%a finite=%d\n",
+                 tag, id, phase, I, RHS [I], isfinite (RHS [I]) ? 1 : 0);
+        observed++;
+    }
+    return observed;
+}
+
+static int
+SMPsnapshotMNA_sparse (SMPmatrix *Matrix, double *RHS, int size,
+                       long id, int tnode, int iterno, double ckt_time,
+                       long ckt_mode, int backend_flag, const char *phase,
+                       long long *entries_expected, long long *entries_observed,
+                       long long *vector_observed)
+{
+    MatrixPtr M = Matrix->SPmatrix;
+    ElementPtr pElement;
+    int I, ext_row, ext_col;
+    int guards = 0;
+
+    *entries_expected = 0;
+    *entries_observed = 0;
+    *vector_observed = 0;
+    if (M == NULL || M->FirstInCol == NULL || M->IntToExtRowMap == NULL ||
+        M->IntToExtColMap == NULL) {
+        fprintf (stderr, "[MNA_SNAPSHOT_GUARD] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=sparse_structure_maps_unavailable\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase);
+        return MNA_SNAP_STRUCT;
+    }
+    if (strcmp (phase, "prefactor") == 0) {
+        /* pass 1: read-only validation/count over all safely traversable
+         * FirstInCol/NextInCol chains. entries_expected is the EXACT full
+         * stored-entry count even when a range defect exists; the internal
+         * range check precedes any map indexing, so an invalid position is
+         * never indexed. Range guards are recorded and counted. */
+        for (I = 1; I <= M->Size; I++) {
+            for (pElement = M->FirstInCol [I]; pElement != NULL;
+                 pElement = pElement->NextInCol) {
+                (*entries_expected)++;
+                if (pElement->Row < 1 || pElement->Row > M->Size ||
+                    I < 1 || I > M->Size) {
+                    fprintf (stderr, "[MNA_SNAPSHOT_GUARD] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=internal_range entry=%lld row=%d col=%d\n",
+                             id, tnode, iterno, ckt_time, ckt_mode, backend_flag,
+                             phase, *entries_expected, pElement->Row, I);
+                    guards++;
+                    continue;
+                }
+                ext_row = M->IntToExtRowMap [pElement->Row];
+                ext_col = M->IntToExtColMap [I];
+                if (ext_row < 1 || ext_row > size || ext_col < 1 ||
+                    ext_col > size) {
+                    fprintf (stderr, "[MNA_SNAPSHOT_GUARD] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=external_range entry=%lld ext_row=%d ext_col=%d\n",
+                             id, tnode, iterno, ckt_time, ckt_mode, backend_flag,
+                             phase, *entries_expected, ext_row, ext_col);
+                    guards++;
+                    continue;
+                }
+            }
+        }
+        if (guards != 0) {
+            /* fail closed: no entry/vector payload; the exact full expected
+             * count is still reported so truncation is detectable */
+            return MNA_SNAP_RANGE;
+        }
+        /* pass 2: emit pass — only after a clean validation pass */
+        for (I = 1; I <= M->Size; I++) {
+            for (pElement = M->FirstInCol [I]; pElement != NULL;
+                 pElement = pElement->NextInCol) {
+                ext_row = M->IntToExtRowMap [pElement->Row];
+                ext_col = M->IntToExtColMap [I];
+                fprintf (stderr, "[MNA_SNAPSHOT_ENTRY] id=%ld phase=%s row=%d col=%d value=%a finite=%d\n",
+                         id, phase, ext_row, ext_col, pElement->Real,
+                         isfinite (pElement->Real) ? 1 : 0);
+                (*entries_observed)++;
+            }
+        }
+        *vector_observed = SMPsnapshotMNA_emit_vector (RHS, size, "RHS", id, phase);
+    } else {
+        /* postsolve: the solution vector, same external identity */
+        *vector_observed = SMPsnapshotMNA_emit_vector (RHS, size, "SOL", id, phase);
+    }
+    return MNA_SNAP_OK;
+}
+
+int
+SMPsnapshotMNA (SMPmatrix *Matrix, double *RHS, int size, int backend_flag,
+                const char *phase, long id, int tnode, int iterno,
+                double ckt_time, long ckt_mode)
+{
+    long long entries_expected = 0, entries_observed = 0, vector_observed = 0;
+    long long vector_expected = (long long) size;
+    int rc = MNA_SNAP_OK;
+
+    if (Matrix == NULL || RHS == NULL || phase == NULL || size <= 0) {
+        fprintf (stderr, "[MNA_SNAPSHOT_GUARD] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=invalid_argument size=%d\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag,
+                 phase ? phase : "?", size);
+        return MNA_SNAP_ARG;
+    }
+    if (backend_flag != Matrix->CKTkluMODE) {
+        fprintf (stderr, "[MNA_SNAPSHOT_GUARD] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=backend_mismatch flag=%d matrix=%u\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase,
+                 backend_flag, (unsigned int) Matrix->CKTkluMODE);
+        return MNA_SNAP_BACKEND;
+    }
+    if (strcmp (phase, "prefactor") != 0 && strcmp (phase, "postsolve") != 0 &&
+        strcmp (phase, "abort") != 0) {
+        fprintf (stderr, "[MNA_SNAPSHOT_GUARD] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=invalid_phase\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase);
+        return MNA_SNAP_PHASE;
+    }
+    if (strcmp (phase, "abort") == 0) {
+        /* fail-closed marker for a keyed iteration abandoned before solve */
+        fprintf (stderr, "[MNA_SNAPSHOT_ABORT] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=keyed_iteration_abandoned_before_solve\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase);
+        return MNA_SNAP_ABORT;
+    }
+    if (Matrix->CKTkluMODE) {
+        if (strcmp (phase, "prefactor") == 0) {
+            /* Fail closed: the pre-factor KLU CSC is uninitialized at this
+             * lifecycle point (immediately after CKTload, before any
+             * reorder/factor) and the post-conversion identity is
+             * node-collapsed. No completeness claim is emitted. */
+            fprintf (stderr, "[MNA_SNAPSHOT_UNSUPPORTED] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s reason=klu_prefactor_csc_uninitialized\n",
+                     id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase);
+            return MNA_SNAP_UNSUP;
+        }
+        /* postsolve in KLU mode: separately labelled PARTIAL vector
+         * diagnostic only; never implies a complete pre/post MNA pair */
+        fprintf (stderr, "[MNA_SNAPSHOT_BEGIN] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase);
+        vector_observed = SMPsnapshotMNA_emit_vector (RHS, size, "SOL", id, phase);
+        fprintf (stderr, "[MNA_SNAPSHOT_END] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s status=partial entries_expected=0 entries_observed=0 vector_expected=%lld vector_observed=%lld\n",
+                 id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase,
+                 vector_expected, vector_observed);
+        return MNA_SNAP_PARTIAL;
+    }
+    fprintf (stderr, "[MNA_SNAPSHOT_BEGIN] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s\n",
+             id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase);
+    rc = SMPsnapshotMNA_sparse (Matrix, RHS, size, id, tnode, iterno, ckt_time,
+                                ckt_mode, backend_flag, phase, &entries_expected,
+                                &entries_observed, &vector_observed);
+    fprintf (stderr, "[MNA_SNAPSHOT_END] id=%ld tnode=%d iterno=%d time=%a mode=%ld backend=%d phase=%s status=%s entries_expected=%lld entries_observed=%lld vector_expected=%lld vector_observed=%lld\n",
+             id, tnode, iterno, ckt_time, ckt_mode, backend_flag, phase,
+             (rc == MNA_SNAP_OK) ? "complete" : "incomplete", entries_expected,
+             entries_observed, vector_expected, vector_observed);
+    return rc;
+}
