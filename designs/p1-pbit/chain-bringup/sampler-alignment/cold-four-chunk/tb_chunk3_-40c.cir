set filetype=ascii

save v(PBIT_OUT) v(CLK_P) v(xcomp.cml_out_p)
tran 2p 144n 100n 2p

linearize v(PBIT_OUT) v(CLK_P) v(xcomp.cml_out_p)
write raw_chunk3_-40c.raw v(PBIT_OUT) v(CLK_P) v(xcomp.cml_out_p)
.endc
.end
