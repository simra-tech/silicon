XRPB20 rpb19 rpb20 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPB21 rpb20 rpb21 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPB22 rpb21 rpb22 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPB23 rpb22 rpb23 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPB24 rpb23 rpb24 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPB25 rpb24 rpb25 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPB26 rpb25 rpbs vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA1 vss rpa1 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA2 rpa1 rpa2 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA3 rpa2 rpa3 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA4 rpa3 rpa4 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA5 rpa4 rpa5 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA6 rpa5 rpa6 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA7 rpa6 rpa7 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA8 rpa7 rpa8 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA9 rpa8 rpa9 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA10 rpa9 rpa10 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA11 rpa10 rpa11 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA12 rpa11 rpa12 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA13 rpa12 rpa13 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA14 rpa13 rpa14 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA15 rpa14 rpa15 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA16 rpa15 rpa16 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA17 rpa16 rpa17 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA18 rpa17 rpa18 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA19 rpa18 rpa19 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA20 rpa19 rpa20 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA21 rpa20 rpa21 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA22 rpa21 rpa22 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA23 rpa22 rpa23 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA24 rpa23 rpa24 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA25 rpa24 rpa25 vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
XRPA26 rpa25 rpas vss rppd w=2u l=30.8u m=1 b=0 mm_ok=1
* pedestal switches (on in normal mode, open during AZ), at the summing-node end (source near 0 V, matched Vgs)
XSPB rpbs azb sb vss sg13_hv_nmos w=10u l=0.45u ng=1 m=1 mm_ok=1
XSPA rpas azb sa vss sg13_hv_nmos w=10u l=0.45u ng=1 m=1 mm_ok=1
* ---- bias (unit NMOS nu = w4/l1 at 5 uA, unit PMOS pu = w4/l2 at 5 uA)
XMBN ibias ibias vss vss sg13_hv_nmos w=4u l=1u ng=1 m=1 mm_ok=1
XMB2 vbp ibias vss vss sg13_hv_nmos w=4u l=1u ng=1 m=2 mm_ok=1
XMBP vbp vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=2 mm_ok=1
XMB3 vbpc ibias vss vss sg13_hv_nmos w=4u l=1u ng=1 m=1 mm_ok=1
XMBPC vbpc vbpc vdda vdda sg13_hv_pmos w=0.5u l=3u ng=1 m=1 mm_ok=1
XMB4 vbnc vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=1 mm_ok=1
XMBNC vbnc vbnc vss vss sg13_hv_nmos w=1u l=3u ng=1 m=1 mm_ok=1
XMB5 vbl ibias vss vss sg13_hv_nmos w=4u l=1u ng=1 m=4 mm_ok=1
XMB6 vbf vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=1 mm_ok=1
* wide-swing reference (rev 2): XMBF drain at the fold-node voltage through XMBFC (same current density as XMN1)
XMBF vbfs vbf vss vss sg13_hv_nmos w=8u l=2u ng=1 m=1 mm_ok=1
XMBFC vbf vbnc vbfs vss sg13_hv_nmos w=10u l=2u ng=1 m=1 mm_ok=1
XMBL vbl vbl vdd vdd sg13_lv_pmos w=4u l=0.25u ng=1 m=1 mm_ok=1
* ---- stage 1: input pair, tail 40 uA
XMT tail vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=8 mm_ok=1
XM1 f1 sai tail tail sg13_hv_pmos w=40u l=1u ng=8 m=1 mm_ok=1
XM2 f2 sbi tail tail sg13_hv_pmos w=40u l=1u ng=8 m=1 mm_ok=1
* auxiliary (AZ) pair, tail 10 uA
XMTA atail vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=2 mm_ok=1
XA1 f1 h1g atail atail sg13_hv_pmos w=8u l=4u ng=1 m=1 mm_ok=1
XA2 f2 h2g atail atail sg13_hv_pmos w=8u l=4u ng=1 m=1 mm_ok=1
* folding sinks per side: 8 fixed units of 5 uA, mirrored from a PMOS-fed diode (vbf), so they track the PMOS currents,
* + 1/3 x the CMFB diode current. Required 45 uA = 20 (pair) + 5 (aux) + 20 (load).
* Revision 1: 7 fixed units + 2/3 x 15 uA (10 uA); CM loop PM 21-50 deg (failed). Revision 2 (2026-10-21): 8 fixed units + 1/3 x 15 uA
* (5 uA), degenerated fast CMFB pair, slow integrating CMFB path for the DC accuracy (see the CMFB section).
* Sink mirrors use L = 2 um to limit channel-length modulation at the low fold-node voltage.
XMS1 f1 vbf vss vss sg13_hv_nmos w=8u l=2u ng=1 m=8 mm_ok=1
XMC1S f1 vcmfb vss vss sg13_hv_nmos w=8u l=2u ng=1 m=1 mm_ok=1
XMS2 f2 vbf vss vss sg13_hv_nmos w=8u l=2u ng=1 m=8 mm_ok=1
XMC2S f2 vcmfb vss vss sg13_hv_nmos w=8u l=2u ng=1 m=1 mm_ok=1
* NMOS cascodes
XMN1 x1a vbnc f1 vss sg13_hv_nmos w=40u l=2u ng=4 m=1 mm_ok=1
XMN2 x1b vbnc f2 vss sg13_hv_nmos w=40u l=2u ng=4 m=1 mm_ok=1
* PMOS cascoded loads, 20 uA
XMP1 p1 vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=4 mm_ok=1
XMP2 p2 vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=4 mm_ok=1
XMPC1 x1a vbpc p1 vdda sg13_hv_pmos w=16u l=2u ng=2 m=1 mm_ok=1
XMPC2 x1b vbpc p2 vdda sg13_hv_pmos w=16u l=2u ng=2 m=1 mm_ok=1
* ---- stage 2 on VDD: thick NMOS driver, thin PMOS load
XMOA outpi x1a vss vss sg13_hv_nmos w=16u l=0.5u ng=4 m=1 mm_ok=1
XMOB outni x1b vss vss sg13_hv_nmos w=16u l=0.5u ng=4 m=1 mm_ok=1
XMLA outpi vbl vdd vdd sg13_lv_pmos w=40u l=0.25u ng=4 m=1 mm_ok=1
XMLB outni vbl vdd vdd sg13_lv_pmos w=40u l=0.25u ng=4 m=1 mm_ok=1
* Miller compensation with nulling resistor
XRZA x1a cza vss rppd w=1u l=3.6u m=1 b=0 mm_ok=1
XCCA cza outpi cap_cmim w=12u l=12u m=1 mm_ok=1
XRZB x1b czb vss rppd w=1u l=3.6u m=1 b=0 mm_ok=1
XCCB czb outni cap_cmim w=12u l=12u m=1 mm_ok=1
* (no cross-coupled Miller caps)
* ---- CMFB: rhigh sense 2 x 200 k with bypass caps, fast thick PMOS pair (tail 6 x 5 uA, optional source degeneration),
*      diode loads (optional cascodes), optional slow integrating path (revision 2), see gen_isense.py for the options
XRCA outp vcms vss rhigh w=1u l=150u m=1 b=0 mm_ok=1
XRCB outn vcms vss rhigh w=1u l=150u m=1 b=0 mm_ok=1
XCMA outp vcms cap_cmim w=8u l=8u m=1 mm_ok=1
XCMB outn vcms cap_cmim w=8u l=8u m=1 mm_ok=1
XMTC ctail vbp vdda vdda sg13_hv_pmos w=4u l=2u ng=1 m=6 mm_ok=1
XMF1 vcmfb vcmsy sf1 ctail sg13_hv_pmos w=24u l=1u ng=4 m=1 mm_ok=1
XMF2 vcmd vint sf2 ctail sg13_hv_pmos w=24u l=1u ng=4 m=1 mm_ok=1
* CMFB pair source degeneration (rev 2): lowers the CM loop gain at all frequencies
XRDG1 ctail sf1 vss rppd w=1u l=50u m=1 b=0 mm_ok=1
XRDG2 ctail sf2 vss rppd w=1u l=50u m=1 b=0 mm_ok=1
* (no CMFB lag network)
* two-path CMFB (rev 2). Slow path: OTA XMG1 (gate vcms) / XMG2 (gate vcm), long-channel, NMOS mirror load (diode on the
* XMG2 side), output vint at the XMG1 drain integrates on XCI (bottom plate at vcm). vint is the reference gate of the fast pair (XMF2), so
* the slow path moves the fast-path reference until the output CM equals vcm (DC accuracy: slow-OTA offset only).
* Fast path: XMF1/XMF2 with source degeneration (RDG) sets the CM loop crossover.
XMTG gtail vbp vdda vdda sg13_hv_pmos w=0.5u l=2u ng=1 m=1 mm_ok=1
XMG1 vint vcms gtail gtail sg13_hv_pmos w=1u l=24u ng=1 m=1 mm_ok=1
XMG2 vgd vcm gtail gtail sg13_hv_pmos w=1u l=24u ng=1 m=1 mm_ok=1
XMGD vgd vgd vss vss sg13_hv_nmos w=8u l=32u ng=1 m=1 mm_ok=1
XMGM vint vgd vss vss sg13_hv_nmos w=8u l=32u ng=1 m=1 mm_ok=1
XCI vint vcm cap_cmim w=36u l=36u m=1 mm_ok=1
* CMFB diodes with cascodes (rev 2): Vds(XMFD/XMFE) at the fold-node voltage, as the CMFB sinks
XMFD vcmfs vcmfb vss vss sg13_hv_nmos w=8u l=2u ng=1 m=3 mm_ok=1
XMFDC vcmfb vbnc vcmfs vss sg13_hv_nmos w=30u l=2u ng=1 m=1 mm_ok=1
XMFE vcmds vcmd vss vss sg13_hv_nmos w=8u l=2u ng=1 m=3 mm_ok=1
XMFEC vcmd vbnc vcmds vss sg13_hv_nmos w=30u l=2u ng=1 m=1 mm_ok=1
* ---- auto-zero: hold switches and caps
XSH1 h1 azh xh1 vss sg13_hv_nmos w=1u l=0.45u ng=1 m=1 mm_ok=1
XSH2 h2 azh xh2 vss sg13_hv_nmos w=1u l=0.45u ng=1 m=1 mm_ok=1
XCH1 h1 vss cap_cmim w=26u l=26u m=1 mm_ok=1
XCH2 h2 vss cap_cmim w=26u l=26u m=1 mm_ok=1
* hold-path series resistors (rev 2): isolate the hold caps from the stage-1 output node above the AZ servo band
XRH1 x1a xh1 vss rhigh w=1u l=37.5u m=1 b=0 mm_ok=1
XRH2 x1b xh2 vss rhigh w=1u l=37.5u m=1 b=0 mm_ok=1
* RF arm output ends: connected to the outputs in normal mode, to VCM during AZ (network sees Vod = 0 exactly)
XSFA outn azb rfoa vss sg13_hv_nmos w=40u l=0.45u ng=4 m=1 mm_ok=1
XSFB outp azb rfob vss sg13_hv_nmos w=40u l=0.45u ng=4 m=1 mm_ok=1
XSVA rfoa az vcm vss sg13_hv_nmos w=4u l=0.45u ng=1 m=1 mm_ok=1
XSVB rfob az vcm vss sg13_hv_nmos w=4u l=0.45u ng=1 m=1 mm_ok=1
* ---- loop-gain probes (test only; Tian double injection). Driver-side node carries the + terminal and the current injection
Vpop outpi outp dc 0 ac {vo_p}
Vpon outni outn dc 0 ac {vo_n}
Ipop 0 outpi dc 0 ac {io_p}
Ipon 0 outni dc 0 ac {io_n}
Vpsa sa sai dc 0 ac {vi_p}
Vpsb sb sbi dc 0 ac {vi_n}
Ipsa 0 sa dc 0 ac {ii_p}
Ipsb 0 sb dc 0 ac {ii_n}
Vpc vcms vcmsy dc 0 ac {vc}
Ipc 0 vcms dc 0 ac {ic}
Vpq1 h1 h1g dc 0 ac {va_p}
Vpq2 h2 h2g dc 0 ac {va_n}
Ipq1 0 h1 dc 0 ac {ja_p}
Ipq2 0 h2 dc 0 ac {ja_n}
* hold caps tied at DC to the post-AZ voltages (1 GH is open for AC): normal state, switches off
Lhd1 h1 hd1 1G
Vhd1 hd1 0 dc @@VH1@@
Lhd2 h2 hd2 1G
Vhd2 hd2 0 dc @@VH2@@
.ends r1_isense_ch_stb
XA isp isn outa_p outa_n vref vcm iba az azh vdda vdd 0 r1_isense_ch_stb
* ---- r1_safe load of channel a: string, conducting mux paths (path fixture), OC and NEG comparators, code 44, k = 32
Ioa vdda ibias_oa dc {5u*(@@TEMP@@+273.15)/300.15}
Ina vdda ibias_na dc {5u*(@@TEMP@@+273.15)/300.15}
Cba ibias_oa 0 100f
Cbb ibias_na 0 100f
XSTR vref t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 t16 t17 t18 t19 t20 t21 t22 t23 t24 t25 t26 t27 t28 t29 t30 t31 t32 t33 t34 t35 t36 t37 t38 t39 t40 t41 t42 t43 t44 t45 t46 t47 t48 t49 t50 t51 t52 t53 t54 t55 t56 t57 t58 t59 t60 t61 t62 t63 t64 t65 t66 t67 t68 t69 t70 t71 t72 t73 t74 t75 t76 t77 t78 t79 t80 t81 t82 t83 t84 t85 t86 t87 t88 t89 t90 t91 t92 t93 t94 t95 t96 t97 t98 t99 t100 t101 t102 t103 t104 t105 t106 t107 t108 t109 t110 t111 t112 t113 t114 t115 t116 t117 t118 t119 t120 t121 t122 t123 t124 t125 t126 t127 t128 t129 t130 t131 t132 t133 t134 t135 t136 t137 t138 t139 t140 t141 t142 t143 t144 t145 t146 t147 t148 t149 t150 t151 t152 t153 t154 t155 t156 t157 t158 t159 t160 t161 t162 t163 t164 t165 t166 t167 t168 t169 t170 t171 t172 t173 t174 t175 t176 t177 t178 t179 t180 t181 t182 t183 t184 t185 t186 t187 t188 t189 t190 t191 t192 t193 t194 t195 t196 t197 t198 t199 t200 t201 t202 t203 t204 t205 t206 t207 t208 t209 t210 t211 t212 t213 t214 t215 t216 t217 t218 t219 t220 t221 t222 t223 t224 t225 t226 t227 t228 t229 t230 t231 t232 t233 t234 t235 t236 t237 t238 t239 t240 t241 t242 t243 t244 t245 t246 t247 t248 t249 t250 t251 t252 0 r1_safe_string
* oa: cell code 44: REFP = T176, REFN = T76
Xmpoa_on0 t176 vdda mpoa_l0 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpoa_off0 t177 0 mpoa_l0 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
