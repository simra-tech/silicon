Xmnoa_off1 t78 0 mnoa_l1 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_on2 mnoa_l1 vdda mnoa_l2 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_off2 t72 0 mnoa_l2 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_on3 mnoa_l2 vdda mnoa_l3 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_off3 t68 0 mnoa_l3 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_on4 mnoa_l3 vdda mnoa_l4 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_off4 t92 0 mnoa_l4 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_on5 mnoa_l4 vdda mnoa_l5 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_off5 t108 0 mnoa_l5 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_on6 mnoa_l5 vdda mnoa_l6 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_off6 t12 0 mnoa_l6 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_on7 mnoa_l6 vdda refn_oa 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnoa_off7 t204 0 refn_oa 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
XOA outa_p outa_n refp_oa refn_oa oc_a ibias_oa vdda vdd 0 r1_safe_cmp
* na: cell code 19: REFP = T76, REFN = T176
Xmpna_on0 t76 vdda mpna_l0 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off0 t77 0 mpna_l0 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on1 mpna_l0 vdda mpna_l1 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off1 t78 0 mpna_l1 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on2 mpna_l1 vdda mpna_l2 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off2 t72 0 mpna_l2 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on3 mpna_l2 vdda mpna_l3 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off3 t68 0 mpna_l3 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on4 mpna_l3 vdda mpna_l4 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off4 t92 0 mpna_l4 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on5 mpna_l4 vdda mpna_l5 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off5 t108 0 mpna_l5 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on6 mpna_l5 vdda mpna_l6 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off6 t12 0 mpna_l6 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_on7 mpna_l6 vdda refp_na 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmpna_off7 t204 0 refp_na 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on0 t176 vdda mnna_l0 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off0 t177 0 mnna_l0 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on1 mnna_l0 vdda mnna_l1 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off1 t178 0 mnna_l1 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on2 mnna_l1 vdda mnna_l2 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off2 t180 0 mnna_l2 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on3 mnna_l2 vdda mnna_l3 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off3 t184 0 mnna_l3 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on4 mnna_l3 vdda mnna_l4 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off4 t160 0 mnna_l4 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on5 mnna_l4 vdda mnna_l5 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off5 t144 0 mnna_l5 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on6 mnna_l5 vdda mnna_l6 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off6 t240 0 mnna_l6 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_on7 mnna_l6 vdda refn_na 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
Xmnna_off7 t48 0 refn_na 0 sg13_hv_nmos w=0.5u l=0.45u ng=1 m=1 mm_ok=1
XNA outa_n outa_p refp_na refn_na neg_a ibias_na vdda vdd 0 r1_safe_cmp
CL1 oc_a 0 10f
CL2 neg_a 0 10f
* ADC input load per output: series @@RL@@ ohm + @@CL@@ to ground + @@CW@@ wiring (joint fixture: 0.001 ohm, 2p, 0)
Rld1 outa_p ldp @@RL@@
Cld1 ldp 0 @@CL@@
Rld2 outa_n ldn @@RL@@
Cld2 ldn 0 @@CL@@
Cw1 outa_p 0 @@CW@@
Cw2 outa_n 0 @@CW@@
.control
let li = 0
foreach vs 0
  foreach lp 1 2 3 6 7
    if $lp = 1
      alterparam vo_p=1
      alterparam vo_n=-1
    end
    if $lp = 2
      alterparam vo_p=1
      alterparam vo_n=1
    end
    if $lp = 3
      alterparam vc=1
    end
    if $lp = 4
      alterparam vi_p=1
      alterparam vi_n=-1
    end
    if $lp = 5
      alterparam vi_p=1
      alterparam vi_n=1
    end
    if $lp = 6
      alterparam va_p=1
      alterparam va_n=-1
    end
    if $lp = 7
      alterparam va_p=1
      alterparam va_n=1
    end
    reset
    alter vin dc = $vs
    ac dec 20 100 1g
    alterparam vo_p=0
    alterparam vo_n=0
    alterparam io_p=0
    alterparam io_n=0
    alterparam vi_p=0
    alterparam vi_n=0
    alterparam ii_p=0
    alterparam ii_n=0
    alterparam vc=0
    alterparam ic=0
    alterparam va_p=0
    alterparam va_n=0
    alterparam ja_p=0
    alterparam ja_n=0
    if $lp = 1
      alterparam io_p=1
      alterparam io_n=-1
    end
    if $lp = 2
      alterparam io_p=1
      alterparam io_n=1
    end
    if $lp = 3
      alterparam ic=1
    end
    if $lp = 4
      alterparam ii_p=1
      alterparam ii_n=-1
    end
    if $lp = 5
      alterparam ii_p=1
      alterparam ii_n=1
    end
    if $lp = 6
      alterparam ja_p=1
      alterparam ja_n=-1
    end
    if $lp = 7
      alterparam ja_p=1
      alterparam ja_n=1
    end
    reset
    alter vin dc = $vs
    ac dec 20 100 1g
    alterparam vo_p=0
    alterparam vo_n=0
    alterparam io_p=0
    alterparam io_n=0
    alterparam vi_p=0
    alterparam vi_n=0
    alterparam ii_p=0
    alterparam ii_n=0
    alterparam vc=0
    alterparam ic=0
    alterparam va_p=0
    alterparam va_n=0
    alterparam ja_p=0
    alterparam ja_n=0
    if $lp = 1
      let v1 = (ac1.v(xa.outpi)-ac1.v(xa.outni))/2
      let i1 = (ac1.i(v.xa.vpop)-ac1.i(v.xa.vpon))/2
      let v2 = (ac2.v(xa.outpi)-ac2.v(xa.outni))/2
      let i2 = (ac2.i(v.xa.vpop)-ac2.i(v.xa.vpon))/2
    end
    if $lp = 2
      let v1 = (ac1.v(xa.outpi)+ac1.v(xa.outni))/2
      let i1 = (ac1.i(v.xa.vpop)+ac1.i(v.xa.vpon))/2
      let v2 = (ac2.v(xa.outpi)+ac2.v(xa.outni))/2
      let i2 = (ac2.i(v.xa.vpop)+ac2.i(v.xa.vpon))/2
    end
    if $lp = 3
      let v1 = ac1.v(xa.vcms)
      let i1 = ac1.i(v.xa.vpc)
      let v2 = ac2.v(xa.vcms)
      let i2 = ac2.i(v.xa.vpc)
    end
    if $lp = 4
      let v1 = (ac1.v(xa.sa)-ac1.v(xa.sb))/2
      let i1 = (ac1.i(v.xa.vpsa)-ac1.i(v.xa.vpsb))/2
      let v2 = (ac2.v(xa.sa)-ac2.v(xa.sb))/2
      let i2 = (ac2.i(v.xa.vpsa)-ac2.i(v.xa.vpsb))/2
    end
    if $lp = 5
      let v1 = (ac1.v(xa.sa)+ac1.v(xa.sb))/2
      let i1 = (ac1.i(v.xa.vpsa)+ac1.i(v.xa.vpsb))/2
      let v2 = (ac2.v(xa.sa)+ac2.v(xa.sb))/2
      let i2 = (ac2.i(v.xa.vpsa)+ac2.i(v.xa.vpsb))/2
    end
    if $lp = 6
      let v1 = (ac1.v(xa.h1)-ac1.v(xa.h2))/2
      let i1 = (ac1.i(v.xa.vpq1)-ac1.i(v.xa.vpq2))/2
      let v2 = (ac2.v(xa.h1)-ac2.v(xa.h2))/2
      let i2 = (ac2.i(v.xa.vpq1)-ac2.i(v.xa.vpq2))/2
    end
    if $lp = 7
      let v1 = (ac1.v(xa.h1)+ac1.v(xa.h2))/2
      let i1 = (ac1.i(v.xa.vpq1)+ac1.i(v.xa.vpq2))/2
      let v2 = (ac2.v(xa.h1)+ac2.v(xa.h2))/2
      let i2 = (ac2.i(v.xa.vpq1)+ac2.i(v.xa.vpq2))/2
    end
    let tl = -1/(1-1/(2*(i1*v2-v1*i2)+v1+i2))
    let tdb = db(tl)
    let tph = 180/pi*cph(tl)
    let fid = 10*li + $lp
    wrdata @@OUT@@_t$&fid tdb tph
    echo "STBFILE level=$vs loop=$lp"
    destroy all
  end
  let li = li + 1
end
.endc
.end
