  OBS
    LAYER TopMetal1 ;
      RECT 324.820 321.000 339.820 1279.000 ;
      RECT 344.820 321.000 361.800 1279.000 ;
      RECT 1240.420 321.000 1255.420 1279.000 ;
      RECT 1260.420 321.000 1275.420 1279.000 ;
      RECT 1240.420 347.160 1255.420 1252.300 ;
      RECT 344.820 347.160 359.820 1252.300 ;
      RECT 1260.420 327.160 1275.420 1272.300 ;
      RECT 324.820 327.160 339.820 1272.300 ;
    LAYER TopMetal2 ;
      RECT 344.820 1237.300 1255.420 1252.300 ;
      RECT 344.820 347.160 1255.420 362.160 ;
      RECT 328.000 1257.300 1272.000 1272.300 ;
      RECT 328.000 327.160 1272.000 342.160 ;
