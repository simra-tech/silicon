VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

# R1 pad ring reference abstract (empty core). Units um. Pins: bondpad TopMetal2 squares (70 x 70 um).
# Core window and ring: see README. Obstructions: core power ring (TopMetal1 / TopMetal2).

MACRO r1_padring
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN r1_padring 0 0 ;
  SIZE 1600 BY 1600 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER TopMetal2 ;
        RECT 415.000 66.000 485.000 136.000 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER TopMetal2 ;
        RECT 555.000 66.000 625.000 136.000 ;
        RECT 975.000 66.000 1045.000 136.000 ;
    END
  END VSS
  PIN IOVDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER TopMetal2 ;
        RECT 695.000 66.000 765.000 136.000 ;
    END
  END IOVDD
  PIN IOVSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER TopMetal2 ;
        RECT 835.000 66.000 905.000 136.000 ;
        RECT 1115.000 66.000 1185.000 136.000 ;
    END
  END IOVSS
  PIN VDDA
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER TopMetal2 ;
        RECT 1464.000 415.000 1534.000 485.000 ;
    END
  END VDDA
  PIN ISA_P
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 1464.000 555.000 1534.000 625.000 ;
    END
  END ISA_P
  PIN ISA_N
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 1464.000 695.000 1534.000 765.000 ;
    END
  END ISA_N
  PIN ISB_P
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 1464.000 835.000 1534.000 905.000 ;
    END
  END ISB_P
  PIN ISB_N
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 1464.000 975.000 1534.000 1045.000 ;
    END
  END ISB_N
  PIN FAULT_N
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 1464.000 1115.000 1534.000 1185.000 ;
    END
  END FAULT_N
  PIN GATE_A
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 415.000 1464.000 485.000 1534.000 ;
    END
  END GATE_A
  PIN GATE_B
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 555.000 1464.000 625.000 1534.000 ;
    END
  END GATE_B
  PIN GATE_C
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 695.000 1464.000 765.000 1534.000 ;
    END
  END GATE_C
  PIN CS_N
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 835.000 1464.000 905.000 1534.000 ;
    END
  END CS_N
  PIN MA_SCLK
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 975.000 1464.000 1045.000 1534.000 ;
    END
  END MA_SCLK
  PIN SLO_SDO
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 1115.000 1464.000 1185.000 1534.000 ;
    END
  END SLO_SDO
  PIN SDI
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 66.000 415.000 136.000 485.000 ;
    END
  END SDI
  PIN EN_STO_IN
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 66.000 555.000 136.000 625.000 ;
    END
  END EN_STO_IN
  PIN SIN_P
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 66.000 695.000 136.000 765.000 ;
    END
  END SIN_P
  PIN SIN_N
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TopMetal2 ;
        RECT 66.000 835.000 136.000 905.000 ;
    END
  END SIN_N
  PIN COS_P
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
