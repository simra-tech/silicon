      RECT 1340.420 321.000 1355.420 1379.000 ;
      RECT 1360.420 321.000 1375.420 1379.000 ;
      RECT 1340.420 347.160 1355.420 1352.300 ;
      RECT 344.820 347.160 359.820 1352.300 ;
      RECT 1360.420 327.160 1375.420 1372.300 ;
      RECT 324.820 327.160 339.820 1372.300 ;
    LAYER TopMetal2 ;
      RECT 344.820 1337.300 1355.420 1352.300 ;
      RECT 344.820 347.160 1355.420 362.160 ;
      RECT 328.000 1357.300 1372.000 1372.300 ;
