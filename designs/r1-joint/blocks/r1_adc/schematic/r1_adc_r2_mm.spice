.ends r1_th2_fast

* ---------------------------------------------------------------------------------------------
* r1_sar2_logic: XSPICE SAR register, 13 decisions per slice, raw-bit output (D12).
* Timing inputs from r1_ctrl (ideal sources in the decks): mclk, wina, winb, lata, latb, stb0..stb25,
* track signals trka0 trka1 trkb0 trkb1 (flag reset of slice X while either of its paths tracks).
* Comparator clocks: clkX = mclk AND winX. Raw bits: ra12..ra0 / rb12..rb0 (ra12 = first decision).
* Per decision: P <= outp at stb, V <= 1 at stb, N = V AND NOT P (one side switches per decision).
* ---------------------------------------------------------------------------------------------
.subckt r1_sar2_logic oap oan obp obn mclk wina winb trka0 trka1 trkb0 trkb1 lata latb stb0 stb1 stb2 stb3 stb4 stb5 stb6 stb7 stb8 stb9 stb10 stb11 stb12 stb13 stb14 stb15 stb16 stb17 stb18 stb19 stb20 stb21 stb22 stb23 stb24 stb25 clka clkab clkb clkbb cpa11 cpa10 cpa9 cpa8 cpa7 cpa6 cpa5 cpa4 cpa3 cpa2 cpa1 cpa0 cna11 cna10 cna9 cna8 cna7 cna6 cna5 cna4 cna3 cna2 cna1 cna0 cpb11 cpb10 cpb9 cpb8 cpb7 cpb6 cpb5 cpb4 cpb3 cpb2 cpb1 cpb0 cnb11 cnb10 cnb9 cnb8 cnb7 cnb6 cnb5 cnb4 cnb3 cnb2 cnb1 cnb0 rawa rawb vdd gnd
.model r1_adcb adc_bridge(in_low=0.6 in_high=0.6 rise_delay=20p fall_delay=20p)
.model r1_dacb dac_bridge(out_low=0 out_high=1.2 out_undef=0.6 input_load=1e-15 t_rise=80p t_fall=80p)
.model r1_dff d_dff(clk_delay=80p set_delay=80p reset_delay=80p ic=0 rise_delay=20p fall_delay=20p)
.model r1_and d_and(rise_delay=30p fall_delay=30p)
.model r1_nand d_nand(rise_delay=30p fall_delay=30p)
.model r1_or d_or(rise_delay=30p fall_delay=30p)
ABR [vdd oap oan obp obn mclk wina winb trka0 trka1 trkb0 trkb1 lata latb stb0 stb1 stb2 stb3 stb4 stb5 stb6 stb7 stb8 stb9 stb10 stb11 stb12 stb13 stb14 stb15 stb16 stb17 stb18 stb19 stb20 stb21 stb22 stb23 stb24 stb25] [d_vdd d_oap d_oan d_obp d_obn d_mclk d_wina d_winb d_trka0 d_trka1 d_trkb0 d_trkb1 d_lata d_latb d_stb0 d_stb1 d_stb2 d_stb3 d_stb4 d_stb5 d_stb6 d_stb7 d_stb8 d_stb9 d_stb10 d_stb11 d_stb12 d_stb13 d_stb14 d_stb15 d_stb16 d_stb17 d_stb18 d_stb19 d_stb20 d_stb21 d_stb22 d_stb23 d_stb24 d_stb25] r1_adcb
