* r1_adc_r2_mm.spice -- R1 12-bit SAR ADC revision 2, schematic-level library (generated by gen_r1_adc_r2.py; do not edit)
* Requires: cornerMOSlv.lib, cornerMOShv.lib (r1_refbuf), cornerCAP.lib, cornerRES.lib (r1_refbuf), XSPICE digital code models, PSP/R3 OSDI.
* Mismatch-capable copy: MOS instances carry mm_ok={mmos} (deck sets .param mmos).

* ---------------------------------------------------------------------------------------------
* r1_bootsw: bootstrapped NMOS sampling switch (unchanged from revision 1).
* ---------------------------------------------------------------------------------------------
.subckt r1_bootsw vin out trk trkb vdd gnd wsw=6u cboot=200f
XMS   vin  g    out  gnd  sg13_lv_nmos w={wsw} l=0.13u ng=2 m=1 mm_ok={mmos}
Cboot cbp  cbn  {cboot}
XM1   cbn  trkb gnd  gnd  sg13_lv_nmos w=1u l=0.13u ng=1 m=1 mm_ok={mmos}
XM3   cbp  g    vdd  cbp  sg13_lv_pmos w=1u l=0.13u ng=1 m=1 mm_ok={mmos}
XM8   g    x    cbp  cbp  sg13_lv_pmos w=2u l=0.13u ng=1 m=1 mm_ok={mmos}
XM4   x    trk  vdd  vdd  sg13_lv_pmos w=0.5u l=0.13u ng=1 m=1 mm_ok={mmos}
XM5   x    trk  cbn  gnd  sg13_lv_nmos w=1u l=0.13u ng=1 m=1 mm_ok={mmos}
XM7   x    g    cbn  gnd  sg13_lv_nmos w=0.5u l=0.13u ng=1 m=1 mm_ok={mmos}
XM9   cbn  g    vin  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1 mm_ok={mmos}
XM10  g    vdd  n10  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1 mm_ok={mmos}
XM11  n10  trkb gnd  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1 mm_ok={mmos}
.ends r1_bootsw

.subckt r1_offsw vin out gnd wsw=6u
XMS   vin  gnd  out  gnd  sg13_lv_nmos w={wsw} l=0.13u ng=2 m=1 mm_ok={mmos}
.ends r1_offsw

* bottom-plate drivers (unchanged): in=0 -> out=VREF, in=1 -> out=GND
.subckt r1_drv in out vref gnd wp=1u wn=0.5u
XMP out in vref vref sg13_lv_pmos w={wp} l=0.13u ng=1 m=1 mm_ok={mmos}
XMN out in gnd  gnd  sg13_lv_nmos w={wn} l=0.13u ng=1 m=1 mm_ok={mmos}
.ends r1_drv

.subckt r1_drv_sw in out vref gnd
BU vref out i=(v(vref)-v(out))*(1e-12+2.5e-3*(0.5-0.5*tanh(20*(v(in)-0.6))))
BD out gnd i=(v(out)-v(gnd))*(1e-12+2.5e-3*(0.5+0.5*tanh(20*(v(in)-0.6))))
.ends r1_drv_sw

* ---------------------------------------------------------------------------------------------
* r1_cdac2_side: one side of the revision-2 split array. Unit Cu = cap_cmim 3.78u x 3.78u (22.04 fF).
* top: C11..C7 = 16, 8, 4, 2, 1 Cu; bridge Cb = cap_cmim 4.23u x 4.23u (1.249 Cu) top-lsb;
* lsb: C6..C0 = 64, 32, 16, 8, 4, 2, 1 Cu (sub-binary with the top array). Nominal (m=).
* ---------------------------------------------------------------------------------------------
.subckt r1_cdac2_side top lsb b11 b10 b9 b8 b7 b6 b5 b4 b3 b2 b1 b0
XC11 top b11 cap_cmim w=3.78u l=3.78u m=16
XC10 top b10 cap_cmim w=3.78u l=3.78u m=8
XC9 top b9 cap_cmim w=3.78u l=3.78u m=4
XC8 top b8 cap_cmim w=3.78u l=3.78u m=2
XC7 top b7 cap_cmim w=3.78u l=3.78u m=1
XC6 lsb b6 cap_cmim w=3.78u l=3.78u m=64
XC5 lsb b5 cap_cmim w=3.78u l=3.78u m=32
XC4 lsb b4 cap_cmim w=3.78u l=3.78u m=16
XC3 lsb b3 cap_cmim w=3.78u l=3.78u m=8
XC2 lsb b2 cap_cmim w=3.78u l=3.78u m=4
XC1 lsb b1 cap_cmim w=3.78u l=3.78u m=2
XC0 lsb b0 cap_cmim w=3.78u l=3.78u m=1
XCB top lsb cap_cmim w=4.23u l=4.23u m=1
.ends r1_cdac2_side

* ---------------------------------------------------------------------------------------------
* r1_cdac2_side_mc: one side of the revision-2 split array. Unit Cu = cap_cmim 3.78u x 3.78u (22.04 fF).
* top: C11..C7 = 16, 8, 4, 2, 1 Cu; bridge Cb = cap_cmim 4.23u x 4.23u (1.249 Cu) top-lsb;
* lsb: C6..C0 = 64, 32, 16, 8, 4, 2, 1 Cu (sub-binary with the top array). One instance per unit (mismatch MC, mm_ok={mm}).
