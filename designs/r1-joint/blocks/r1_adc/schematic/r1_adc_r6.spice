.ends r1_th4_fast

* ---------------------------------------------------------------------------------------------
* r1_th4_fast_mc: one revision-4 track-and-hold slice (CDAC P and N, top-plate sampling, 13 caps per side).
* in0 sampled while trk0=1, in1 while trk1=1 (never both); sample on the falling edge. lsb nodes reset
* to VREF while either path tracks. cpK/cnK = 1: bottom plate K of side P/N goes VREF -> GND.
* Fast variant: in1 pair reduced to r1_offsw, trk1 unused; drivers r1_drv_sw (ideal 400 ohm).
* ---------------------------------------------------------------------------------------------
.subckt r1_th4_fast_mc in0p in0n in1p in1n trk0 trk1 top_p top_n cp12 cp11 cp10 cp9 cp8 cp7 cp6 cp5 cp4 cp3 cp2 cp1 cp0 cn12 cn11 cn10 cn9 cn8 cn7 cn6 cn5 cn4 cn3 cn2 cn1 cn0 vdd vref vrefl gnd
XPT0a t0b trk0 vdd vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XNT0a t0b trk0 gnd gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XPT0b t0 t0b vdd vdd sg13_lv_pmos w=4u l=0.13u ng=1 m=1
XNT0b t0 t0b gnd gnd sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XS0P in0p top_p t0 t0b vdd gnd r1_bootsw
XS0N in0n top_n t0 t0b vdd gnd r1_bootsw
XS1P in1p top_p gnd r1_offsw
XS1N in1n top_n gnd r1_offsw
Rtrk1 trk1 gnd 1e9
XLRP lsb_p t0b vrefl vrefl sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XLRN lsb_n t0b vrefl vrefl sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XDACP top_p lsb_p bp12 bp11 bp10 bp9 bp8 bp7 bp6 bp5 bp4 bp3 bp2 bp1 bp0 r1_cdac3_side_mc mm=1
XDACN top_n lsb_n bn12 bn11 bn10 bn9 bn8 bn7 bn6 bn5 bn4 bn3 bn2 bn1 bn0 r1_cdac3_side_mc mm=1
XDp12 cp12 bp12 vref gnd r1_drv_sw
