* revision 4: LSB-array drivers C7..C0 and the lsb-node reset on vrefl
.ends r1_th4_fast_mc

* ---------------------------------------------------------------------------------------------
* r1_sar5_logic (revision 5: decision 0 from the NMOS comparator r1_cmp5n, clocks clkn*): XSPICE SAR registers, 14 decisions, one register per slice (D17/D18: both slices convert
* in parallel, own comparator and own register). Timing inputs from r1_ctrl (ideal in the decks): mclk
* (from r1_cmp4_clkgen), wina/winb (conversion windows), stba0..13 / stbb0..13 (decision strobes, one set
* per slice: slice B may run N ticks after slice A), lata/latb, track signals (flag reset while tracking).
* Per decision: P <= outp at stb, V <= 1 at stb, N = V AND NOT P (exactly one side switches).
* Raw bits rX13..rX0 (rX13 = first decision) latched at latX.
* ---------------------------------------------------------------------------------------------
.subckt r1_sar5_logic oap oan obp obn oanp obnp mclk wina winb trka0 trka1 trkb0 trkb1 lata latb stba0 stba1 stba2 stba3 stba4 stba5 stba6 stba7 stba8 stba9 stba10 stba11 stba12 stba13 stbb0 stbb1 stbb2 stbb3 stbb4 stbb5 stbb6 stbb7 stbb8 stbb9 stbb10 stbb11 stbb12 stbb13 clka clkab clkb clkbb clkna clknab clknb clknbb cpa12 cpa11 cpa10 cpa9 cpa8 cpa7 cpa6 cpa5 cpa4 cpa3 cpa2 cpa1 cpa0 cna12 cna11 cna10 cna9 cna8 cna7 cna6 cna5 cna4 cna3 cna2 cna1 cna0 cpb12 cpb11 cpb10 cpb9 cpb8 cpb7 cpb6 cpb5 cpb4 cpb3 cpb2 cpb1 cpb0 cnb12 cnb11 cnb10 cnb9 cnb8 cnb7 cnb6 cnb5 cnb4 cnb3 cnb2 cnb1 cnb0 rawa rawb vdd gnd
.model r1_adcb adc_bridge(in_low=0.6 in_high=0.6 rise_delay=20p fall_delay=20p)
.model r1_dacb dac_bridge(out_low=0 out_high=1.2 out_undef=0.6 input_load=1e-15 t_rise=80p t_fall=80p)
.model r1_dff d_dff(clk_delay=80p set_delay=80p reset_delay=80p ic=0 rise_delay=20p fall_delay=20p)
.model r1_and d_and(rise_delay=30p fall_delay=30p)
.model r1_nand d_nand(rise_delay=30p fall_delay=30p)
.model r1_or d_or(rise_delay=30p fall_delay=30p)
ABR [vdd oap oan obp obn oanp obnp mclk wina winb trka0 trka1 trkb0 trkb1 lata latb stba0 stba1 stba2 stba3 stba4 stba5 stba6 stba7 stba8 stba9 stba10 stba11 stba12 stba13 stbb0 stbb1 stbb2 stbb3 stbb4 stbb5 stbb6 stbb7 stbb8 stbb9 stbb10 stbb11 stbb12 stbb13] [d_vdd d_oap d_oan d_obp d_obn d_oanp d_obnp d_mclk d_wina d_winb d_trka0 d_trka1 d_trkb0 d_trkb1 d_lata d_latb d_stba0 d_stba1 d_stba2 d_stba3 d_stba4 d_stba5 d_stba6 d_stba7 d_stba8 d_stba9 d_stba10 d_stba11 d_stba12 d_stba13 d_stbb0 d_stbb1 d_stbb2 d_stbb3 d_stbb4 d_stbb5 d_stbb6 d_stbb7 d_stbb8 d_stbb9 d_stbb10 d_stbb11 d_stbb12 d_stbb13] r1_adcb
AGA1 [d_mclk d_wina] g_clka r1_and
AGA2 [d_mclk d_wina] g_clkab r1_nand
AGB1 [d_mclk d_winb] g_clkb r1_and
