* r1_adc_r6.spice -- R1 12-bit SAR ADC revision 6, schematic-level library (generated by gen_r1_adc_r6.py; do not edit)
* Revision 6 (PLAN.md D28): the revision-5 library below, unchanged, plus r1_cmp6_clkgen (comparator strobe from the
* falling clk30 edge), r1_refbuf6 (LSB-array follower x3) and the cores r1_adc6_core(_fast, _fast_mc). The revision-5
* text follows from its second line on.
* Requires: cornerMOSlv.lib, cornerMOShv.lib (reference cells), cornerCAP.lib, cornerRES.lib, XSPICE digital code models, PSP/R3 OSDI.
* Unchanged revision-4 cells (same names): r1_bootsw, r1_offsw, r1_drv(_sw), r1_cdac3_side(_mc), r1_cmp4(_s1),
* r1_cmp4_bias, r1_cmp4_clkgen, r1_th4, r1_th4_fast, r1_th4_fast_mc.

* ---------------------------------------------------------------------------------------------
* r1_bootsw: bootstrapped NMOS sampling switch (unchanged from revision 1).
* ---------------------------------------------------------------------------------------------
.subckt r1_bootsw vin out trk trkb vdd gnd wsw=6u cboot=200f
XMS   vin  g    out  gnd  sg13_lv_nmos w={wsw} l=0.13u ng=2 m=1
Cboot cbp  cbn  {cboot}
XM1   cbn  trkb gnd  gnd  sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XM3   cbp  g    vdd  cbp  sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XM8   g    x    cbp  cbp  sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XM4   x    trk  vdd  vdd  sg13_lv_pmos w=0.5u l=0.13u ng=1 m=1
XM5   x    trk  cbn  gnd  sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XM7   x    g    cbn  gnd  sg13_lv_nmos w=0.5u l=0.13u ng=1 m=1
XM9   cbn  g    vin  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XM10  g    vdd  n10  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XM11  n10  trkb gnd  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1
.ends r1_bootsw

.subckt r1_offsw vin out gnd wsw=6u
XMS   vin  gnd  out  gnd  sg13_lv_nmos w={wsw} l=0.13u ng=2 m=1
.ends r1_offsw

* bottom-plate drivers (unchanged): in=0 -> out=VREF, in=1 -> out=GND
.subckt r1_drv in out vref gnd wp=1u wn=0.5u
XMP out in vref vref sg13_lv_pmos w={wp} l=0.13u ng=1 m=1
XMN out in gnd  gnd  sg13_lv_nmos w={wn} l=0.13u ng=1 m=1
.ends r1_drv

.subckt r1_drv_sw in out vref gnd
BU vref out i=(v(vref)-v(out))*(1e-12+2.5e-3*(0.5-0.5*tanh(20*(v(in)-0.6))))
BD out gnd i=(v(out)-v(gnd))*(1e-12+2.5e-3*(0.5+0.5*tanh(20*(v(in)-0.6))))
.ends r1_drv_sw

* ---------------------------------------------------------------------------------------------
* r1_cdac3_side: one side of the revision-3 split array (14 decisions). Unit Cu = cap_cmim 3.78u x 3.78u (22.04 fF).
* top: C12..C8 = 16, 8, 4, 2, 1 Cu; bridge Cb = cap_cmim 4.23u x 4.23u (1.249 Cu) top-lsb;
* lsb: C7..C1 = 64, 32, 16, 8, 4, 2, 1 Cu, C0 = cap_cmim 2.67u x 2.67u (half unit). Nominal (m=).
* ---------------------------------------------------------------------------------------------
.subckt r1_cdac3_side top lsb b12 b11 b10 b9 b8 b7 b6 b5 b4 b3 b2 b1 b0
XC12 top b12 cap_cmim w=3.78u l=3.78u m=16
XC11 top b11 cap_cmim w=3.78u l=3.78u m=8
XC10 top b10 cap_cmim w=3.78u l=3.78u m=4
XC9 top b9 cap_cmim w=3.78u l=3.78u m=2
XC8 top b8 cap_cmim w=3.78u l=3.78u m=1
XC7 lsb b7 cap_cmim w=3.78u l=3.78u m=64
XC6 lsb b6 cap_cmim w=3.78u l=3.78u m=32
XC5 lsb b5 cap_cmim w=3.78u l=3.78u m=16
XC4 lsb b4 cap_cmim w=3.78u l=3.78u m=8
XC3 lsb b3 cap_cmim w=3.78u l=3.78u m=4
XC2 lsb b2 cap_cmim w=3.78u l=3.78u m=2
XC1 lsb b1 cap_cmim w=3.78u l=3.78u m=1
XC0 lsb b0 cap_cmim w=2.67u l=2.67u m=1
XCB top lsb cap_cmim w=4.23u l=4.23u m=1
.ends r1_cdac3_side

* ---------------------------------------------------------------------------------------------
* r1_cdac3_side_mc: one side of the revision-3 split array (14 decisions). Unit Cu = cap_cmim 3.78u x 3.78u (22.04 fF).
* top: C12..C8 = 16, 8, 4, 2, 1 Cu; bridge Cb = cap_cmim 4.23u x 4.23u (1.249 Cu) top-lsb;
* lsb: C7..C1 = 64, 32, 16, 8, 4, 2, 1 Cu, C0 = cap_cmim 2.67u x 2.67u (half unit). One instance per unit (mismatch MC).
