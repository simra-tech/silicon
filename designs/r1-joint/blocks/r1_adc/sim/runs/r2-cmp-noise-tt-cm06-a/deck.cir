wrdata <G1_RESULTS_ROOT>/r1_adc/r2-cmp-noise-tt-cm06-a/noise_V1.txt inoise_spectrum onoise_spectrum
destroy all
reset
op
print i(vdpV2) i(vdnV2)
noise v(outV2) vinp dec 20 1e3 1e11
setplot noise1
wrdata <G1_RESULTS_ROOT>/r1_adc/r2-cmp-noise-tt-cm06-a/noise_V2.txt inoise_spectrum onoise_spectrum
destroy all
reset
op
print i(vdpV3) i(vdnV3)
