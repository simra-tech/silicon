* tb_th_skew_nominal.cir (generated by gen_tb_th_skew.py) -- T/H sampling skew, 10 copies
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib mos_tt
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib cap_typ
.include schematic/r1_adc.spice
.temp 27
.option reltol=1e-4 vntol=1e-7 abstol=1e-13 method=trap
Vdd vdd 0 1.2
Vref vref 0 1.2
* common track signal: high until t_edge (50 ps fall), as distributed from one r1_ctrl output
Vtrk trk 0 PWL(0 1.2 9.9975e-08 1.2 1.00025e-07 0)
Vz z 0 0
Vcm cm 0 0.6
* copy 0: V0 = -0.9 V, S = 2e+07 V/s
Bp0 ip0 0 v=0.6+(-0.9+2e+07*(time-1e-07))/2
Bn0 in0 0 v=0.6-(-0.9+2e+07*(time-1e-07))/2
XTHa0 ip0 in0 cm cm trk z tap0 tan0 z z z z z z z z z z z z z z z z z z z z z z vdd vref 0 r1_th
Ccap0 tap0 0 30f
Ccan0 tan0 0 30f
XTHb0 ip0 in0 cm cm trk z tbp0 tbn0 z z z z z z z z z z z z z z z z z z z z z z vdd vref 0 r1_th
Ccbp0 tbp0 0 30f
Ccbn0 tbn0 0 30f
