* r1_adc.spice -- R1 12-bit SAR ADC, schematic-level library (generated by gen_r1_adc.py; do not edit)
* Requires: cornerMOSlv.lib (mos_*), cornerCAP.lib (cap_*), XSPICE digital code models, PSP OSDI.

* ---------------------------------------------------------------------------------------------
* r1_bootsw: bootstrapped NMOS sampling switch. trk=1 (trkb=0): out follows vin, gate g = vin + VDD.
* Boost capacitor ideal 200 fF in this step (to be a MIM or MOS capacitor in layout).
* Thin-oxide stress: every device sees <= VDD between any two terminals (MN10 splits the g discharge).
* ---------------------------------------------------------------------------------------------
.subckt r1_bootsw vin out trk trkb vdd gnd wsw=6u cboot=200f
XMS   vin  g    out  gnd  sg13_lv_nmos w={wsw} l=0.13u ng=2 m=1
Cboot cbp  cbn  {cboot}
XM1   cbn  trkb gnd  gnd  sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XM3   cbp  g    vdd  cbp  sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XM8   g    x    cbp  cbp  sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XM4   x    trk  vdd  vdd  sg13_lv_pmos w=0.5u l=0.13u ng=1 m=1
XM5   x    trk  cbn  gnd  sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XM7   x    g    cbn  gnd  sg13_lv_nmos w=0.5u l=0.13u ng=1 m=1
XM9   cbn  g    vin  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XM10  g    vdd  n10  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XM11  n10  trkb gnd  gnd  sg13_lv_nmos w=2u l=0.13u ng=1 m=1
.ends r1_bootsw

* r1_offsw: main device of a deselected bootstrapped switch (gate held at gnd), load and feed-through model
.subckt r1_offsw vin out gnd wsw=6u
XMS   vin  gnd  out  gnd  sg13_lv_nmos w={wsw} l=0.13u ng=2 m=1
.ends r1_offsw

* ---------------------------------------------------------------------------------------------
* Bottom-plate drivers. in=0 -> out=VREF (reset / sampling state); in=1 -> out=GND (monotonic step).
* ---------------------------------------------------------------------------------------------
.subckt r1_drv in out vref gnd wp=1u wn=0.5u
XMP out in vref vref sg13_lv_pmos w={wp} l=0.13u ng=1 m=1
XMN out in gnd  gnd  sg13_lv_nmos w={wn} l=0.13u ng=1 m=1
.ends r1_drv

* fast-deck driver: ideal smooth conductance pair, Ron 400 ohm, Roff 1e12 (marked ideal in run records).
* s = 0.5*(1+tanh(20*(v(in)-0.6))): in=0 -> out tied to VREF, in=1.2 -> out tied to GND. Current is drawn from VREF.
.subckt r1_drv_sw in out vref gnd
BU vref out i=(v(vref)-v(out))*(1e-12+2.5e-3*(0.5-0.5*tanh(20*(v(in)-0.6))))
BD out gnd i=(v(out)-v(gnd))*(1e-12+2.5e-3*(0.5+0.5*tanh(20*(v(in)-0.6))))
.ends r1_drv_sw

* ---------------------------------------------------------------------------------------------
* r1_cdac_side: one side of the split 6+6 bridge array. Unit Cu = cap_cmim 3.78u x 3.78u (22.04 fF).
* MSB array on top: C10..C6 = 16,8,4,2,1 Cu; bridge Cb = 1 Cu (top-lsb); LSB array on lsb: C5..C0 = 32..1 Cu
* (63 Cu, no dummy, so Cb/(63+Cb) = 1/64 exactly). Bottom plates b10..b0. Nominal: multipliers m=.
* ---------------------------------------------------------------------------------------------
.subckt r1_cdac_side top lsb b10 b9 b8 b7 b6 b5 b4 b3 b2 b1 b0
XC10 top b10 cap_cmim w=3.78u l=3.78u m=16
XC9 top b9 cap_cmim w=3.78u l=3.78u m=8
XC8 top b8 cap_cmim w=3.78u l=3.78u m=4
XC7 top b7 cap_cmim w=3.78u l=3.78u m=2
XC6 top b6 cap_cmim w=3.78u l=3.78u m=1
XC5 lsb b5 cap_cmim w=3.78u l=3.78u m=32
XC4 lsb b4 cap_cmim w=3.78u l=3.78u m=16
XC3 lsb b3 cap_cmim w=3.78u l=3.78u m=8
XC2 lsb b2 cap_cmim w=3.78u l=3.78u m=4
XC1 lsb b1 cap_cmim w=3.78u l=3.78u m=2
XC0 lsb b0 cap_cmim w=3.78u l=3.78u m=1
XCB top lsb cap_cmim w=3.78u l=3.78u m=1
.ends r1_cdac_side

* r1_cdac_side_mc: same array, one cap_cmim instance per unit so that each unit draws its own
* mismatch value (cap_*_mismatch section, mm_ok=1).
.subckt r1_cdac_side_mc top lsb b10 b9 b8 b7 b6 b5 b4 b3 b2 b1 b0 mm=1
XC10_0 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_1 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_2 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_3 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_4 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_5 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_6 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_7 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_8 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_9 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_10 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_11 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_12 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_13 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_14 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC10_15 top b10 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_0 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_1 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_2 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_3 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_4 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_5 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_6 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC9_7 top b9 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC8_0 top b8 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC8_1 top b8 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC8_2 top b8 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC8_3 top b8 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC7_0 top b7 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC7_1 top b7 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC6_0 top b6 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_0 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_1 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_2 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_3 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_4 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_5 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_6 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_7 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_8 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_9 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_10 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_11 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_12 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_13 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_14 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_15 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_16 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_17 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
