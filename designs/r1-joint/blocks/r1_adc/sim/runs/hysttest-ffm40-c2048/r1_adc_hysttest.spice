XC5_23 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_24 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_25 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_26 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_27 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_28 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_29 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_30 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC5_31 lsb b5 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC4_0 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC4_1 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
