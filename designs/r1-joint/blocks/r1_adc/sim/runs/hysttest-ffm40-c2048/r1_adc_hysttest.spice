* ---------------------------------------------------------------------------------------------
* r1_sar_logic: XSPICE digital SAR register (behavioural-structural, B/BN flags as in
* AnalogAcademy sar_logic.v). Timing inputs (mclk, winA, winB, rst, lat, stb0..stb23) come from the
* controller (r1_ctrl); in this step from ideal sources in the test bench.
* Outputs: clkA/clkAb, clkB/clkBb comparator clocks; cpaK/cnaK, cpbK/cnbK bottom-plate controls;
* codeA/codeB analog image of the latched 12-bit codes (0..4095) for the decks.
* ---------------------------------------------------------------------------------------------
.subckt r1_sar_logic oap oan obp obn mclk wina winb rst lat stb0 stb1 stb2 stb3 stb4 stb5 stb6 stb7 stb8 stb9 stb10 stb11 stb12 stb13 stb14 stb15 stb16 stb17 stb18 stb19 stb20 stb21 stb22 stb23 clka clkab clkb clkbb cpa10 cpa9 cpa8 cpa7 cpa6 cpa5 cpa4 cpa3 cpa2 cpa1 cpa0 cna10 cna9 cna8 cna7 cna6 cna5 cna4 cna3 cna2 cna1 cna0 cpb10 cpb9 cpb8 cpb7 cpb6 cpb5 cpb4 cpb3 cpb2 cpb1 cpb0 cnb10 cnb9 cnb8 cnb7 cnb6 cnb5 cnb4 cnb3 cnb2 cnb1 cnb0 codea codeb vdd gnd
.model r1_adcb adc_bridge(in_low=0.6 in_high=0.6 rise_delay=20p fall_delay=20p)
.model r1_adcbh adc_bridge(in_low=0.2 in_high=1.0 rise_delay=20p fall_delay=20p)
.model r1_dacb dac_bridge(out_low=0 out_high=1.2 out_undef=0.6 input_load=1e-15 t_rise=80p t_fall=80p)
.model r1_dff d_dff(clk_delay=80p set_delay=80p reset_delay=80p ic=0 rise_delay=20p fall_delay=20p)
.model r1_and d_and(rise_delay=30p fall_delay=30p)
.model r1_nand d_nand(rise_delay=30p fall_delay=30p)
ABRC [oap oan obp obn] [d_oap d_oan d_obp d_obn] r1_adcbh
ABR [mclk wina winb rst lat stb0 stb1 stb2 stb3 stb4 stb5 stb6 stb7 stb8 stb9 stb10 stb11 stb12 stb13 stb14 stb15 stb16 stb17 stb18 stb19 stb20 stb21 stb22 stb23] [d_mclk d_wina d_winb d_rst d_lat d_stb0 d_stb1 d_stb2 d_stb3 d_stb4 d_stb5 d_stb6 d_stb7 d_stb8 d_stb9 d_stb10 d_stb11 d_stb12 d_stb13 d_stb14 d_stb15 d_stb16 d_stb17 d_stb18 d_stb19 d_stb20 d_stb21 d_stb22 d_stb23] r1_adcb
