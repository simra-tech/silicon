XC4_11 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC4_12 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC4_13 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC4_14 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC4_15 lsb b4 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_0 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_1 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_2 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_3 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_4 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_5 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_6 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC3_7 lsb b3 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC2_0 lsb b2 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC2_1 lsb b2 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC2_2 lsb b2 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC2_3 lsb b2 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC1_0 lsb b1 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC1_1 lsb b1 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XC0_0 lsb b0 cap_cmim w=3.78u l=3.78u mm_ok={mm}
XCB top lsb cap_cmim w=3.78u l=3.78u mm_ok={mm}
.ends r1_cdac_side_mc

* ---------------------------------------------------------------------------------------------
* r1_cmp: double-tail dynamic comparator (AnalogAcademy module 3 / Lin 2010 lineage, Schinkel stage 2).
* PMOS input pair so that the input common mode may fall from 0.6 V to ~0 V (monotonic switching).
* clk=1, clkb=0: evaluate. clk=0: reset, outp = outn = VDD. Decision: inp > inn -> outp stays high.
* ---------------------------------------------------------------------------------------------
.subckt r1_cmp inp inn clk clkb outp outn vdd gnd
XMT1 tail clkb vdd  vdd sg13_lv_pmos w=8u l=0.13u ng=2 m=1
XM1  dip  inp  tail vdd sg13_lv_pmos w=16u l=0.2u ng=4 m=1
XM2  din  inn  tail vdd sg13_lv_pmos w=16u l=0.2u ng=4 m=1
XMR1 dip  clkb gnd  gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XMR2 din  clkb gnd  gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XMT2 lt   clk  gnd  gnd sg13_lv_nmos w=4u l=0.13u ng=1 m=1
XMN1 outp outn lt   gnd sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XMN2 outn outp lt   gnd sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XMP1 outp outn vdd  vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XMP2 outn outp vdd  vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XMH1 outp dip  vdd  vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XMH2 outn din  vdd  vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
* output buffers (load of the SAR register inputs)
XBP1 outpb outp vdd vdd sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XBN1 outpb outp gnd gnd sg13_lv_nmos w=0.5u l=0.13u ng=1 m=1
XBP2 outnb outn vdd vdd sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XBN2 outnb outn gnd gnd sg13_lv_nmos w=0.5u l=0.13u ng=1 m=1
Cbp outpb gnd 3f
Cbn outnb gnd 3f
.ends r1_cmp

* ---------------------------------------------------------------------------------------------
* r1_th: one track-and-hold slice = CDAC P and N with top-plate sampling.
* in0 (encoder SIN or COS) sampled when trk0=1, in1 (current channel) when trk1=1. The sample is
* taken on the falling edge of trk0/trk1 (common for both slices). lsb nodes reset to VREF in track.
* cpK/cnK = 1: bottom plate of capacitor K on side P/N goes VREF -> GND.
* top_p/top_n are the comparator inputs.
* Full variant: both input pairs with complete bootstrapped switches; transistor drivers.
* ---------------------------------------------------------------------------------------------
.subckt r1_th in0p in0n in1p in1n trk0 trk1 top_p top_n cp10 cp9 cp8 cp7 cp6 cp5 cp4 cp3 cp2 cp1 cp0 cn10 cn9 cn8 cn7 cn6 cn5 cn4 cn3 cn2 cn1 cn0 vdd vref gnd
XPT0a t0b trk0 vdd vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XNT0a t0b trk0 gnd gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XPT0b t0 t0b vdd vdd sg13_lv_pmos w=4u l=0.13u ng=1 m=1
XNT0b t0 t0b gnd gnd sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XPT1a t1b trk1 vdd vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XNT1a t1b trk1 gnd gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XPT1b t1 t1b vdd vdd sg13_lv_pmos w=4u l=0.13u ng=1 m=1
XNT1b t1 t1b gnd gnd sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XS0P in0p top_p t0 t0b vdd gnd r1_bootsw
XS0N in0n top_n t0 t0b vdd gnd r1_bootsw
XS1P in1p top_p t1 t1b vdd gnd r1_bootsw
XS1N in1n top_n t1 t1b vdd gnd r1_bootsw
* lsb reset gate rstb = NOT(t0 OR t1) = AND(t0b, t1b) (static CMOS)
XPR1 rstb_n t0b vdd vdd sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XPR2 rstb_n t1b vdd vdd sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XNR1 rstb_n t0b nr gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XNR2 nr t1b gnd gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XPR3 rstb rstb_n vdd vdd sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XNR3 rstb rstb_n gnd gnd sg13_lv_nmos w=0.5u l=0.13u ng=1 m=1
* lsb-node reset to VREF during track (PMOS, gate low in track)
XLRP lsb_p rstb vref vref sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XLRN lsb_n rstb vref vref sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XDACP top_p lsb_p bp10 bp9 bp8 bp7 bp6 bp5 bp4 bp3 bp2 bp1 bp0 r1_cdac_side
XDACN top_n lsb_n bn10 bn9 bn8 bn7 bn6 bn5 bn4 bn3 bn2 bn1 bn0 r1_cdac_side
XDp10 cp10 bp10 vref gnd r1_drv wp=2u wn=1u
XDp9 cp9 bp9 vref gnd r1_drv wp=2u wn=1u
XDp8 cp8 bp8 vref gnd r1_drv wp=2u wn=1u
XDp7 cp7 bp7 vref gnd r1_drv wp=1u wn=0.5u
XDp6 cp6 bp6 vref gnd r1_drv wp=1u wn=0.5u
XDp5 cp5 bp5 vref gnd r1_drv wp=1u wn=0.5u
XDp4 cp4 bp4 vref gnd r1_drv wp=1u wn=0.5u
XDp3 cp3 bp3 vref gnd r1_drv wp=1u wn=0.5u
XDp2 cp2 bp2 vref gnd r1_drv wp=1u wn=0.5u
XDp1 cp1 bp1 vref gnd r1_drv wp=1u wn=0.5u
XDp0 cp0 bp0 vref gnd r1_drv wp=1u wn=0.5u
XDn10 cn10 bn10 vref gnd r1_drv wp=2u wn=1u
XDn9 cn9 bn9 vref gnd r1_drv wp=2u wn=1u
XDn8 cn8 bn8 vref gnd r1_drv wp=2u wn=1u
XDn7 cn7 bn7 vref gnd r1_drv wp=1u wn=0.5u
XDn6 cn6 bn6 vref gnd r1_drv wp=1u wn=0.5u
XDn5 cn5 bn5 vref gnd r1_drv wp=1u wn=0.5u
XDn4 cn4 bn4 vref gnd r1_drv wp=1u wn=0.5u
XDn3 cn3 bn3 vref gnd r1_drv wp=1u wn=0.5u
XDn2 cn2 bn2 vref gnd r1_drv wp=1u wn=0.5u
XDn1 cn1 bn1 vref gnd r1_drv wp=1u wn=0.5u
XDn0 cn0 bn0 vref gnd r1_drv wp=1u wn=0.5u
.ends r1_th

* ---------------------------------------------------------------------------------------------
* r1_th_fast: one track-and-hold slice = CDAC P and N with top-plate sampling.
* in0 (encoder SIN or COS) sampled when trk0=1, in1 (current channel) when trk1=1. The sample is
* taken on the falling edge of trk0/trk1 (common for both slices). lsb nodes reset to VREF in track.
* cpK/cnK = 1: bottom plate of capacitor K on side P/N goes VREF -> GND.
* top_p/top_n are the comparator inputs.
* Fast variant: deselected input pair = r1_offsw only; drivers r1_drv_sw (ideal switches).
* ---------------------------------------------------------------------------------------------
.subckt r1_th_fast in0p in0n in1p in1n trk0 trk1 top_p top_n cp10 cp9 cp8 cp7 cp6 cp5 cp4 cp3 cp2 cp1 cp0 cn10 cn9 cn8 cn7 cn6 cn5 cn4 cn3 cn2 cn1 cn0 vdd vref gnd
XPT0a t0b trk0 vdd vdd sg13_lv_pmos w=2u l=0.13u ng=1 m=1
XNT0a t0b trk0 gnd gnd sg13_lv_nmos w=1u l=0.13u ng=1 m=1
XPT0b t0 t0b vdd vdd sg13_lv_pmos w=4u l=0.13u ng=1 m=1
XNT0b t0 t0b gnd gnd sg13_lv_nmos w=2u l=0.13u ng=1 m=1
XS0P in0p top_p t0 t0b vdd gnd r1_bootsw
XS0N in0n top_n t0 t0b vdd gnd r1_bootsw
XS1P in1p top_p gnd r1_offsw
XS1N in1n top_n gnd r1_offsw
* trk1 unused in the fast variant (deselected path)
Rtrk1 trk1 gnd 1e9
* lsb-node reset to VREF during track (PMOS, gate low in track)
XLRP lsb_p t0b vref vref sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XLRN lsb_n t0b vref vref sg13_lv_pmos w=1u l=0.13u ng=1 m=1
XDACP top_p lsb_p bp10 bp9 bp8 bp7 bp6 bp5 bp4 bp3 bp2 bp1 bp0 r1_cdac_side
XDACN top_n lsb_n bn10 bn9 bn8 bn7 bn6 bn5 bn4 bn3 bn2 bn1 bn0 r1_cdac_side
XDp10 cp10 bp10 vref gnd r1_drv_sw
XDp9 cp9 bp9 vref gnd r1_drv_sw
XDp8 cp8 bp8 vref gnd r1_drv_sw
