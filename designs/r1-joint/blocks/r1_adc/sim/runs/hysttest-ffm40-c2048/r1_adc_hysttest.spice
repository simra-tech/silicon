ADB [g_clka g_clkab g_clkb g_clkbb fpa0 fna0 fpa1 fna1 fpa2 fna2 fpa3 fna3 fpa4 fna4 fpa5 fna5 fpa6 fna6 fpa7 fna7 fpa8 fna8 fpa9 fna9 fpa10 fna10 qa0 qa1 qa2 qa3 qa4 qa5 qa6 qa7 qa8 qa9 qa10 qa11 fpb0 fnb0 fpb1 fnb1 fpb2 fnb2 fpb3 fnb3 fpb4 fnb4 fpb5 fnb5 fpb6 fnb6 fpb7 fnb7 fpb8 fnb8 fpb9 fnb9 fpb10 fnb10 qb0 qb1 qb2 qb3 qb4 qb5 qb6 qb7 qb8 qb9 qb10 qb11] [clka clkab clkb clkbb cpa10 cna10 cpa9 cna9 cpa8 cna8 cpa7 cna7 cpa6 cna6 cpa5 cna5 cpa4 cna4 cpa3 cna3 cpa2 cna2 cpa1 cna1 cpa0 cna0 qa_a0 qa_a1 qa_a2 qa_a3 qa_a4 qa_a5 qa_a6 qa_a7 qa_a8 qa_a9 qa_a10 qa_a11 cpb10 cnb10 cpb9 cnb9 cpb8 cnb8 cpb7 cnb7 cpb6 cnb6 cpb5 cnb5 cpb4 cnb4 cpb3 cnb3 cpb2 cnb2 cpb1 cnb1 cpb0 cnb0 qa_b0 qa_b1 qa_b2 qa_b3 qa_b4 qa_b5 qa_b6 qa_b7 qa_b8 qa_b9 qa_b10 qa_b11] r1_dacb
