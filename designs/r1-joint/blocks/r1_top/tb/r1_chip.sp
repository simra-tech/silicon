* r1_chip.sp -- R1 full-chip testbench netlist (track T10), generated by tb/gen_chip.py; do not edit
* Top-level nodes: pads in upper case (spec section 3), internal nets as the chip LVS reference (lower case).
* Needs: PDK models, sg13g2_io.spice, sg13g2_stdcell.spice, one block view (views/sch.inc), views/ctrl_rtl.inc.

* ---------------- pads (PDK sg13g2_io cells; core side = pad terminal for the analog pads, as the chip CDL) ----
XP_sin_p SIN_P padres_sin_p VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_sin_n SIN_N padres_sin_n VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_cos_p COS_P padres_cos_p VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_cos_n COS_N padres_cos_n VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_isa_p ISA_P padres_isa_p VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_isa_n ISA_N padres_isa_n VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_isb_p ISB_P padres_isb_p VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_isb_n ISB_N padres_isb_n VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_vdda VDDA padres_vdda VDD VSS IOVDD IOVSS sg13g2_IOPadAnalog
XP_cs_n CS_N cs_n_p2c VDD VSS IOVDD IOVSS sg13g2_IOPadIn
XP_ma_sclk MA_SCLK ma_sclk_p2c VDD VSS IOVDD IOVSS sg13g2_IOPadIn
XP_sdi SDI sdi_p2c VDD VSS IOVDD IOVSS sg13g2_IOPadIn
XP_en_sto_in EN_STO_IN en_sto_in_p2c VDD VSS IOVDD IOVSS sg13g2_IOPadIn
XP_fault_n FAULT_N fault_n_c2p VDD VSS IOVDD IOVSS sg13g2_IOPadOut4mA
XP_slo_sdo SLO_SDO slo_sdo_c2p VDD VSS IOVDD IOVSS sg13g2_IOPadOut4mA
XP_gate_a GATE_A gate_a_c2p VDD VSS IOVDD IOVSS sg13g2_IOPadOut30mA
XP_gate_b GATE_B gate_b_c2p VDD VSS IOVDD IOVSS sg13g2_IOPadOut30mA
XP_gate_c GATE_C gate_c_c2p VDD VSS IOVDD IOVSS sg13g2_IOPadOut30mA

* ---------------- analog blocks ----------------
XU_BGR VDDA VSS vref_bg bgr_iptat pbias pcasc bgr_vbe bgr_dvbe r1_bgr
* MODEL M6 (T10 finding R1): no block of record buffers vref_bg. r1_bgr has a source of about 180 kOhm; the
* r1_safe string (252 kOhm) and the r1_isense pedestals load it to 0.22 V (run t10-diag-nodeset-b). Ideal unity
* buffer with 10 Ohm output for the resistive loads (isense, safe). T2F and the ADC filter keep vref_bg (gate inputs).
Evref_m6 vref_m6i VSS vref_bg VSS 1
Rvref_m6 vref_m6i vref_l 10
XU_BIAS VDDA VDD VSS pbias pcasc ib_afe_s1 ib_afe_s2 ib_afe_c1 ib_afe_c2 ib_is_a ib_is_b ib_sf_oa ib_sf_na ib_sf_ob ib_sf_nb ib_adc_ref por_n r1_bias
XU_T2F VDDA VDD VSS pbias pcasc vref_bg t2f_en33 t2f_mode33 t2f_fout r1_t2f
* PENDING-IN-LAYOUT: t2f en/mode level shifters u_ls_t2f0/1 are placed but not connected in try e
XU_LS_T2F0 t2f_en t2f_en33 VDD VDDA VSS t10_ls
XU_LS_T2F1 t2f_mode t2f_mode33 VDD VDDA VSS t10_ls
* PENDING-IN-LAYOUT: PGA lines pga_c[3:0] -> u_ls_afe0..3 -> r1_afe c1..c4
XU_LS_AFE0 pga_c0 afe_c1 VDD VDDA VSS t10_ls
XU_LS_AFE1 pga_c1 afe_c2 VDD VDDA VSS t10_ls
XU_LS_AFE2 pga_c2 afe_c3 VDD VDDA VSS t10_ls
XU_LS_AFE3 pga_c3 afe_c4 VDD VDDA VSS t10_ls
* PENDING-IN-LAYOUT: AFE outputs and vcm2 to the ADC
XU_AFE SIN_P SIN_N COS_P COS_N souts_p souts_n soutc_p soutc_n vcm2 ib_afe_s1 ib_afe_s2 ib_afe_c1 ib_afe_c2 afe_c1 afe_c2 afe_c3 afe_c4 VDDA VSS r1_afe
* PENDING-IN-LAYOUT: isense outputs (to the ADC and to r1_safe), vcm, az/azh
XU_ISENSE ISA_P ISA_N ISB_P ISB_N outa_p outa_n outb_p outb_n vref_l vcm ib_is_a ib_is_b az_a azh_a az_b azh_b VDDA VDD VSS r1_isense
* PENDING-IN-LAYOUT: safe comparator inputs outa_p/n, outb_p/n (try e lists them as diagnostics) and the 64 tap
* inputs (ctrl 0.5 tap_p/tap_n; comparator i = 0 OC_A, 1 NEG_A, 2 OC_B, 3 NEG_B at [8i +: 8], bit 0 = LSB)
XU_SAFE outa_p outa_n outb_p outb_n vref_l
+ tap_p0 tap_p1 tap_p2 tap_p3 tap_p4 tap_p5 tap_p6 tap_p7 tap_n0 tap_n1 tap_n2 tap_n3 tap_n4 tap_n5 tap_n6 tap_n7
+ tap_p8 tap_p9 tap_p10 tap_p11 tap_p12 tap_p13 tap_p14 tap_p15 tap_n8 tap_n9 tap_n10 tap_n11 tap_n12 tap_n13 tap_n14 tap_n15
