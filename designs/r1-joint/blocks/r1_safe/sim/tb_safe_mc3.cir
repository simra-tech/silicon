.control
set wr_singlescale
set wr_vecnames
setseed @@SEED@@
let half = @@VDD@@/2
let i = 0
while i < @@N@@
  reset
  alter vsh dc = 0
  tran 1n 9.5e-06 0 2n
  let oc_krel = -1
  let oc_ktrip = -1
  let j = 0
  while j < 34
    let ts = 2.5e-06 + (j + 1)*2e-07 - 2n
    meas tran vv find v(oc) at=$&ts
    if j < 17
      if (oc_krel < 0) & (vv < half)
        let oc_krel = 28 + j
      end
    else
      if (oc_ktrip < 0) & (vv > half)
        let oc_ktrip = 44 - (j - 17)
      end
    end
    let j = j + 1
  end
  let oc_kc = 32 + floor((oc_krel + oc_ktrip)/2 - 36.307692 + 0.5)
  if oc_kc > 63
    let oc_kc = 63
  end
  if oc_kc < 0
    let oc_kc = 0
  end
  let dd = oc_kc - 32
  let np = 216 + (0 - floor((0 - dd)/2))
  let nn = 36 - floor(dd/2)
  if np > 252
    let np = 252
  end
  if np < 0
    let np = 0
  end
  if nn > 252
    let nn = 252
  end
  if nn < 0
    let nn = 0
  end
  let cv = 1 - abs(np - 53)
  if cv < 0
    let cv = 0
  end
  alter vcocp53 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 54)
  if cv < 0
    let cv = 0
  end
  alter vcocp54 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 55)
  if cv < 0
    let cv = 0
  end
  alter vcocp55 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 56)
  if cv < 0
    let cv = 0
  end
  alter vcocp56 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 57)
  if cv < 0
    let cv = 0
  end
  alter vcocp57 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 58)
  if cv < 0
    let cv = 0
  end
  alter vcocp58 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 59)
  if cv < 0
    let cv = 0
  end
  alter vcocp59 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 60)
  if cv < 0
    let cv = 0
  end
  alter vcocp60 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 61)
  if cv < 0
    let cv = 0
  end
  alter vcocp61 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 62)
  if cv < 0
    let cv = 0
  end
  alter vcocp62 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 63)
  if cv < 0
    let cv = 0
  end
  alter vcocp63 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 213)
  if cv < 0
    let cv = 0
  end
  alter vcocp213 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 214)
  if cv < 0
    let cv = 0
  end
  alter vcocp214 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 215)
  if cv < 0
    let cv = 0
  end
  alter vcocp215 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 216)
  if cv < 0
    let cv = 0
  end
  alter vcocp216 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 217)
  if cv < 0
    let cv = 0
  end
  alter vcocp217 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 218)
  if cv < 0
    let cv = 0
  end
  alter vcocp218 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 219)
  if cv < 0
    let cv = 0
  end
  alter vcocp219 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 220)
  if cv < 0
    let cv = 0
  end
  alter vcocp220 pwl = [ 0 $&cv 1 $&cv ]
  let cv = 1 - abs(np - 221)
  if cv < 0
    let cv = 0
