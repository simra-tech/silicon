    let ts = 2.5e-06 + (j + 1)*2e-07 - 2n
    meas tran vv find v(ng) at=$&ts
    if j < 17
      if (ng_krel < 0) & (vv < half)
        let ng_krel = 20 + j
      end
    else
      if (ng_ktrip < 0) & (vv > half)
        let ng_ktrip = 36 - (j - 17)
      end
    end
    let j = j + 1
  end
  let ng_kc = 32 + floor((ng_krel + ng_ktrip)/2 - 27.692308 + 0.5)
  if ng_kc > 63
    let ng_kc = 63
