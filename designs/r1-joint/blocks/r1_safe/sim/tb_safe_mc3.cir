  alter vsh pwl = [ 0 0 2.3e-06 0 2.4e-06 0.091956 2.6e-06 0.091956 5.6e-06 0.095956 8.6e-06 0.091956 8.8e-06 -0.0111868 9e-06 -0.0111868 1.2e-05 -0.0151868 1.5e-05 -0.0111868 1.52e-05 0 1.55e-05 0 1.5501e-05 0.103352 1.7e-05 0.103352 1.7001e-05 0 1.8e-05 0 1.8001e-05 -0.0145055 1.95e-05 -0.0145055 1.9501e-05 0 2e-05 0 ]
  tran 1n 20u 0 2n
  meas tran oc_t find v(isp) when v(oc)=half rise=1 from=2.6u to=5.6u
  meas tran oc_r find v(isp) when v(oc)=half fall=1 from=5.6u to=8.6u
  meas tran ng_t find v(isp) when v(ng)=half rise=1 from=9u to=12u
  meas tran ng_r find v(isp) when v(ng)=half fall=1 from=12u to=15u
  meas tran oc_d when v(oc)=half rise=1 from=15.501u to=17u
  meas tran ng_d when v(ng)=half rise=1 from=18.001u to=19.5u
  let oc_err = ((oc_t + oc_r)/2 - 0.093956044)*1e6
  let ng_err = ((ng_t + ng_r)/2 - -0.013186813)*1e6
  let oc_h = (oc_t - oc_r)*1e6
  let ng_h = (ng_r - ng_t)*1e6
  let oc_dl = (oc_d - 15.501u)*1e9
  let ng_dl = (ng_d - 18.001u)*1e9
  echo "MC3" $&i "seed=@@SEED@@ oc_err_uV=" $&oc_err " ng_err_uV=" $&ng_err " oc_hyst_uV=" $&oc_h " ng_hyst_uV=" $&ng_h " oc_dly_ns=" $&oc_dl " ng_dly_ns=" $&ng_dl
