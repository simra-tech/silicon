* Red-team 2026-09-27 trip_path: GATE pad hold-off against drain dV/dt (Miller injection) with the TI CSD16340Q3
* vendor model (unchanged, as in blocks/g1_gate/sim/run_fet_campaign.py), G1_GATE C-PEX, sg13g2_IOPadOut30mA.
* The chip holds the FET off (EN low: gate_core = 0). The drain is driven 0 -> @@VBUS@@ V with a @@TR@@ edge
* through 1 Ohm (e.g. a bus hot-plug or a parallel switch). Gate loop: pad -> @@LG@@ (bond wire + PCB) -> Rg @@RG@@
* Ohm -> FET gate; 10 kOhm gate-source pull-down; fsrc to ground through 25 mOhm shunt + 10 mOhm return.
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib @@MOS@@
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib @@MOS@@
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib res_typ
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib cap_typ
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerDIO.lib dio_tt
.include /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spi
.include /work/designs/g1-guardian/blocks/g1_gate/sim/postlayout/g1_gate_pex.spice
.temp @@TEMP@@
.global sub!
Vsub sub! 0 dc 0
.option method=gear reltol=0.005 itl4=100 abstol=1e-9 vntol=1e-5 chgtol=1e-13
Rsa vdda_s vdda 0.5
Cda vdda 0 1n
Rsd vdd_s vdd 0.5
Cdd vdd 0 1n
Vdda vdda_s 0 dc 3.3
Vdd vdd_s 0 dc 1.2
Ven en_core 0 dc 0
Vtrip trip_d 0 dc 0
Vclr clr_d 0 dc 0
Vhard hard_cmp 0 dc 0
Vfast fast_en 0 dc 0
XG trip_d clr_d fast_en hard_cmp en_core gate_core fault_core tripped vdd vdda 0 g1_gate
XPG gate gate_core vdd 0 vdda 0 sg13g2_IOPadOut30mA
Lg gate gate_l @@LG@@
Rg gate_l gfet @@RG@@
.param ptrc1=3.25e-3 ptrc2=9.0e-6 pwidth=1.3392864 perim=2.7
.incpslt /work/build/g1_gate/vendor/CSD16340Q3.lib
Vd dsrc 0 pwl(0 0 2u 0 {2u+@@TR@@} @@VBUS@@ 6u @@VBUS@@)
Rd dsrc drain 1
Vfet drain dfet 0
XFET dfet gfet fsrc CSD16340Q3
Rshunt fsrc kelvin 25m
Rreturn kelvin 0 10m
Rpulldown gfet fsrc 10k
.control
set filetype=ascii
tran 0.2n 6u
let vgs = v(gfet) - v(fsrc)
meas tran vgs_max max vgs from=1.9u to=6u
meas tran vpad_max max v(gate) from=1.9u to=6u
meas tran id_max max i(vfet) from=1.9u to=6u
meas tran id_end find i(vfet) at=5.9u
meas tran t_vgs_pk when vgs=0.5 rise=1 from=1.9u
meas tran vgs_pre find vgs at=1.9u
echo "DVDT @@TAG@@: vgs_pre=" $&vgs_pre " vgs_max=" $&vgs_max " vpad_max=" $&vpad_max " id_max=" $&id_max " id_end=" $&id_end
.endc
.end
