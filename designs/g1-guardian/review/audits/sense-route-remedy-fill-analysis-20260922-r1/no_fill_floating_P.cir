* no_fill floating drive P; diagnostic capacitor-network AC only
C1 0 N 1.5988500000000001e-15
C2 0 P 5.4831700000000005e-16
C4 0 P 3.38174e-17
C6 N P 4.9427100000000006e-16
C7 N 0 1.3825600000000001e-15
C8 P 0 9.08312e-16
VP P 0 DC 0 AC 1
VN N 0 DC 0 AC 0
.control
set numdgt=17
ac lin 1 1Meg 1Meg
let cp = -imag(i(VP))/(2*pi*1e6)
let cn = -imag(i(VN))/(2*pi*1e6)
print cp cn
quit
.endc
.end
