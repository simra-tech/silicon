echo PRECISE_END
alter Vcm dc=0.0
alter Vsh dc=0
op
echo PRECISE_BEGIN t0_c0_s0
print v(isense)
print v(vped)
print v(vref_buf)
print v(xdut.vp)
print v(xdut.vn)
print v(xdut.vped_ref)
print i(vdd)
echo PRECISE_END
alter Vcm dc=-0.0125
alter Vsh dc=0.025
op
echo PRECISE_BEGIN t0_c0_s0.025
print v(isense)
print v(vped)
print v(vref_buf)
print v(xdut.vp)
print v(xdut.vn)
print v(xdut.vped_ref)
print i(vdd)
echo PRECISE_END
alter Vcm dc=-0.025
alter Vsh dc=0.05
op
echo PRECISE_BEGIN t0_c0_s0.05
print v(isense)
print v(vped)
print v(vref_buf)
print v(xdut.vp)
print v(xdut.vn)
print v(xdut.vped_ref)
print i(vdd)
echo PRECISE_END
alter Vcm dc=0.3
alter Vsh dc=0
op
echo PRECISE_BEGIN t0_c0.3_s0
print v(isense)
print v(vped)
print v(vref_buf)
print v(xdut.vp)
print v(xdut.vn)
print v(xdut.vped_ref)
print i(vdd)
echo PRECISE_END
alter Vcm dc=0.2875
alter Vsh dc=0.025
op
echo PRECISE_BEGIN t0_c0.3_s0.025
print v(isense)
print v(vped)
print v(vref_buf)
print v(xdut.vp)
print v(xdut.vn)
print v(xdut.vped_ref)
print i(vdd)
echo PRECISE_END
alter Vcm dc=0.27499999999999997
alter Vsh dc=0.05
op
echo PRECISE_BEGIN t0_c0.3_s0.05
print v(isense)
print v(vped)
print v(vref_buf)
print v(xdut.vp)
print v(xdut.vn)
print v(xdut.vped_ref)
