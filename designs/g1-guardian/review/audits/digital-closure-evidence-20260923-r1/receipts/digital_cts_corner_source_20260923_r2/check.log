276:proc read_spefs {} {
277:    if { [info exists ::env(_CURRENT_SPEF_BY_CORNER)] } {
278:        set corner_name $::env(_CURRENT_CORNER_NAME)
279:        puts "Reading top-level design parasitics for the '$corner_name' corner at '$::env(_CURRENT_SPEF_BY_CORNER)'…"
280:        read_spef -corner $corner_name $::env(_CURRENT_SPEF_BY_CORNER)
281:    }
282:    if { [info exists ::env(_CURRENT_CORNER_SPEFS)] } {
283:        set corner_name $::env(_CURRENT_CORNER_NAME)
284:        foreach spefs $::env(_CURRENT_CORNER_SPEFS) {
285:            set instance_path [lshift spefs]
286:            foreach spef $spefs {
287:                puts "Reading '$instance_path' parasitics for the '$corner_name' corner at '$spef'…"
288:                read_spef -corner $corner_name -path $instance_path $spef
289:            }
290:        }
291:    }
292:    if { [info exists ::env(_CURRENT_CORNER_EXTRA_SPEFS_BACKCOMPAT)] } {
293:        set corner_name $::env(_CURRENT_CORNER_NAME)
294:        foreach pair $::env(_CURRENT_CORNER_EXTRA_SPEFS_BACKCOMPAT) {
295:            set module_name [lindex $pair 0]
296:            set spef [lindex $pair 1]
297:            foreach cell [get_cells * -hierarchical] {
298:                if { "[get_property $cell ref_name]" eq "$module_name"} {
299:                    set instance_path [get_property $cell full_name]
300:                    puts "Reading '$instance_path' parasitics for the '$corner_name' corner at '$spef'…"
301:                    read_spef -corner $corner_name -path $instance_path $spef
302:                }
303:            }
304:        }
305:    }
306:}
