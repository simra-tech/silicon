394:proc read_current_odb {args} {
395:    sta::parse_key_args "read_current_odb" args \
396:        keys {}\
397:        flags {}
398:
399:    read_pnr_libs
400:    puts "Reading OpenROAD database at '$::env(CURRENT_ODB)'…"
401:    if { [ catch {read_db $::env(CURRENT_ODB)} errmsg ]} {
402:        puts stderr $errmsg
403:        exit 1
404:    }
405:
406:    set_global_vars
407:
408:    # Read supporting views (if applicable)
409:    read_current_sdc
410:    set_dont_use_cells
411:}
