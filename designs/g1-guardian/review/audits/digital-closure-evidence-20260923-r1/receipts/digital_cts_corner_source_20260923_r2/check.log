268:proc lshift {inputlist} {
269:    upvar $inputlist argv
270:    set arg  [lindex $argv 0]
271:    #set argv [lrange $argv 1 end] ;# below is much faster - lreplace can make use of unshared Tcl_Obj to avoid alloc'ing the result
272:    set argv [lreplace $argv[set argv {}] 0 0]
273:    return $arg
274:}
