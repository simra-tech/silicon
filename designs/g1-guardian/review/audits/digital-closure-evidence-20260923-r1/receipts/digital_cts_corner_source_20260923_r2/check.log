308:proc read_pnr_libs {args} {
309:    set i "0"
310:    set tc_key "_LIB_CORNER_$i"
311:    set corner_names [list]
312:    while { [info exists ::env($tc_key)] } {
313:        set corner_name [lindex $::env($tc_key) 0]
314:        set corner_libs [lreplace $::env($tc_key) 0 0]
315:        set corner($corner_name) $corner_libs
316:        incr i
317:        set tc_key "_LIB_CORNER_$i"
318:        lappend corner_names $corner_name
319:    }
320:
321:    define_corners {*}[array name corner]
322:
323:    foreach corner_name [array name corner] {
324:        puts "Reading timing models for corner $corner_name…"
325:
326:        set corner_models $corner($corner_name)
327:        foreach model $corner_models {
328:            puts "Reading timing library for the '$corner_name' corner at '$model'…"
329:            read_liberty -corner $corner_name $model
330:        }
331:
332:        if { [info exists ::env(EXTRA_LIBS) ] } {
333:            puts "Reading explicitly-specified extra libs for $corner_name…"
334:            foreach extra_lib $::env(EXTRA_LIBS) {
335:                puts "Reading extra timing library for the '$corner_name' corner at '$extra_lib'…"
336:                read_liberty -corner $corner_name $extra_lib
337:            }
338:        }
339:    }
340:}
