413:proc _populate_cells_by_class {} {
414:    if { [info exists ::_cells_by_class(physical)] } {
415:        return
416:    }
417:
418:    set ::_cells_by_class(physical) [list]
419:    set ::_cells_by_class(non_timing) [list]
420:    set _comment_ {
421:        We naïvely assume anything not in these classes is not a cell with a
422:        logical function. This may not be comprehensive, but is good enough.
423:
424:        CORE just means a macro used in the core area (i.e. a standard cell.)
425:
426:        Thing is, it has a lot of subclasses for physical cells:
427:
428:        `FEEDTHRU`,`SPACER`,`ANTENNACELL`,`WELLTAP`
429:
430:        Only `TIEHIGH`, `TIELOW` are for logical cells. Thus, the inclusion
431:        list allows them as well. `BLOCKS` are macros, which we cannot discern
432:        whether they have a logical function or not, so we include them
433:        regardless.
434:
435:        We do make one exception for `ANTENNACELL`s. These are not counted as
436:        logical cells but they are not exempt from the so-called SDF-friendly
437:        netlist as they do affect timing ever so slightly.
438:    }
439:    set logical_classes {
440:        BLOCK
441:        BUMP
442:        CORE
443:        CORE_TIEHIGH
444:        CORE_TIELOW
445:        COVER
446:        PAD
447:        PAD_AREAIO
448:        PAD_INOUT
449:        PAD_INPUT
450:        PAD_OUTPUT
451:        PAD_POWER
452:        PAD_SPACER
453:    }
454:
455:    foreach lib $::libs {
456:        foreach master [$lib getMasters] {
457:            if { [lsearch -exact $logical_classes [$master getType]] == -1 } {
458:                lappend ::_cells_by_class(physical) [$master getName]
459:                if { "[$master getType]" != "CORE_ANTENNACELL" } {
460:                    lappend ::_cells_by_class(non_timing) [$master getName]
461:                }
462:            }
463:        }
464:    }
465:}
466:
467:proc get_timing_excluded_cells {args} {
468:    _populate_cells_by_class
469:    return $::_cells_by_class(non_timing)
470:}
471:
472:proc get_physical_cells {args} {
473:    _populate_cells_by_class
474:    return $::_cells_by_class(physical)
475:}
