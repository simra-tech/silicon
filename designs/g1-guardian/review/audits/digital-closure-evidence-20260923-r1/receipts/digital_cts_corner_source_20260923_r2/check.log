251:            if { [string_in_file $verilog_file $blackbox_wildcard] } {
252:                puts "Found '$blackbox_wildcard' in '$verilog_file', skipping…"
253:            } elseif { [catch {puts "Reading Verilog model at '$verilog_file'…"; read_verilog $verilog_file} err] } {
254:                puts stderr "Error while reading $verilog_file:"
255:                puts stderr $err
256:                puts stderr "Make sure that this a gate-level netlist and not an RTL file, otherwise, you can add the following comment '$blackbox_wildcard' in the file to skip it and blackbox the modules inside if needed."
257:                exit 1
258:            }
259:        }
260:    }
261:    if { [info exists flags(-powered)] } {
262:        read_current_netlist -powered
263:    } else {
264:        read_current_netlist
265:    }
266:}
