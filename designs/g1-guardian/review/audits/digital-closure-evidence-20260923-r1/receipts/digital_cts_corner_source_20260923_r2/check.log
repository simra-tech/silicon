342:proc read_tech_lef {{tlef_key "TECH_LEF"}} {
343:    set tlef $::env($tlef_key)
344:
345:    puts "Reading technology LEF file at '$tlef'…"
346:    read_lef $tlef
347:
348:    # Make fake I/O sites
349:    if { [info exists ::env(PAD_FAKE_SITES)] } {
350:        dict for {site_name size} $::env(PAD_FAKE_SITES) {
351:            set width [lindex $size 0]
352:            set height [lindex $size 1]
353:
354:            puts "Making fake IO site $site_name…"
355:            make_fake_io_site -name $site_name -width $width -height $height
356:        }
357:    }
358:}
359:
360:proc read_other_lefs {} {
361:    foreach lef $::env(CELL_LEFS) {
362:        puts "Reading cell LEF file at '$lef'…"
363:        read_lef $lef
364:    }
365:    if { [info exist ::env(MACRO_LEFS)] } {
366:        foreach lef $::env(MACRO_LEFS) {
367:            puts "Reading macro LEF file at '$lef'…"
368:            read_lef $lef
369:        }
370:    }
371:    if { [info exist ::env(PAD_LEFS)] } {
372:        foreach lef $::env(PAD_LEFS) {
373:            puts "Reading gpio pad LEF file at '$lef'…"
374:            read_lef $lef
375:        }
376:    }
377:    if { [info exist ::env(EXTRA_LEFS)] } {
378:        foreach lef $::env(EXTRA_LEFS) {
379:            puts "Reading extra LEF file at '$lef'…"
380:            read_lef $lef
381:        }
382:    }
383:}
384:
385:proc read_lefs {{tlef_key "TECH_LEF"}} {
386:    read_tech_lef $tlef_key
387:    read_other_lefs
388:}
