DDANT vth VDD dpantenna w=0.78u l=0.78u
RRBIAS VDD vbn VSS rppd w=1u l=134.3u b=0 m=1
MMBD vbn vbn VSS VSS sg13_lv_nmos w=2u l=0.5u m=1
XCMPA va vth vbn ca VDD VSS g1_osc_cmp
XCMPB vb vth vbn cb VDD VSS g1_osc_cmp
XEN en en_n VDD VSS g1_osc_inv
XNQ ca en_n qb q VDD VSS g1_osc_nor3
XNQB cb q qb VDD VSS g1_osc_nor2
