XRSTA q rsta VDD VSS g1_osc_inv
XB1 q qn_b VDD VSS g1_osc_inv
XB2 qn_b osc_clk VDD VSS g1_osc_inv
.ends
.subckt g1_osc_cbank t0 t1 t2 t3 top vss
CCF top vss cap_cmim w=31.65u l=31.65u m=1
CCT0 top b0 cap_cmim w=8.16u l=8.16u m=1
MMS0 b0 t0 vss vss sg13_lv_nmos w=4u l=0.13u m=1
