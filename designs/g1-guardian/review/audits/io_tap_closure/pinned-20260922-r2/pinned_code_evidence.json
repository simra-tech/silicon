  {
    "path": "libs.tech/klayout/tech/lvs/rule_decks/tap_extraction.lvs",
    "sha256": "e17c779eacdcab3bfa2287ca265d7836dde0e9e7fec4b4e7bf79bf2b2dd9120b",
    "selected_lines": [
      {
        "line": 24,
        "text": "logger.info('Starting Taps EXTRACTION')"
      },
      {
        "line": 25,
        "text": ""
      },
      {
        "line": 26,
        "text": "# ntap1/ptap1 device extraction is gated by DISABLE_TAP_EXTRACTION (see sg13g2.lvs)."
      },
      {
        "line": 27,
        "text": "# Extraction is enabled by default. When it is disabled, taps are not extracted as"
      },
      {
        "line": 28,
        "text": "# devices so the schematic does not need to contain them, matching Magic+Netgen LVS"
      },
      {
        "line": 29,
        "text": "# behavior. The tap tie regions are still connected to their well/substrate nets via"
      },
      {
        "line": 30,
        "text": "# tap_connections.lvs."
      },
      {
        "line": 31,
        "text": "unless DISABLE_TAP_EXTRACTION"
      },
      {
        "line": 32,
        "text": "  # ntap1"
      },
      {
        "line": 33,
        "text": "  logger.info('Extracting ntap1 device')"
      },
      {
        "line": 34,
        "text": "  # ntap1 is extracted with the diode extractor because the geometry is a nested"
      },
      {
        "line": 35,
        "text": "  # junction (tie inside well). We map diode regions as:"
      },
      {
        "line": 36,
        "text": "  #   - P => ntap1_tie  (tie contact)"
      },
      {
        "line": 37,
        "text": "  #   - N => ntap1_well (nwell body)"
      },
      {
        "line": 38,
        "text": "  # This preserves PDK terminal order in the written netlist as \"TIE WELL\"."
      },
      {
        "line": 39,
        "text": "  # See: https://www.klayout.de/doc/manual/lvs_device_extractors.html#h2-117"
      },
      {
        "line": 40,
        "text": "  cheat(\"*\") {"
      },
      {
        "line": 41,
        "text": "    extract_devices(diode('ntap1', CustomTap), { 'P' => ntap1_tie, 'N' => ntap1_well })"
      },
      {
        "line": 42,
        "text": "  }"
      },
      {
        "line": 43,
        "text": ""
      },
      {
        "line": 44,
        "text": "  # ptap1"
      },
      {
        "line": 45,
        "text": "  logger.info('Extracting ptap1 device')"
      },
      {
        "line": 46,
        "text": "  # ptap1 follows the same P/N region mapping rule:"
      },
      {
        "line": 47,
        "text": "  #   - P => ptap1_tie (tie contact)"
      },
      {
        "line": 48,
        "text": "  #   - N => ptap1_sub (substrate/body region)"
      },
      {
        "line": 49,
        "text": "  cheat(\"*\") {"
      },
      {
        "line": 50,
        "text": "    extract_devices(diode('ptap1', CustomTap), { 'P' => ptap1_tie, 'N' => ptap1_sub })"
      },
      {
        "line": 51,
        "text": "  }"
      },
      {
        "line": 52,
        "text": "else"
      },
      {
        "line": 53,
        "text": "  logger.info('DISABLE_TAP_EXTRACTION is enabled: skipping ntap1/ptap1 device extraction.')"
      },
      {
        "line": 54,
        "text": "end"
      }
    ]
  },
