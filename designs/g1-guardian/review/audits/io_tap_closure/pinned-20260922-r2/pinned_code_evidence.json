      {
        "line": 209,
        "text": "class TapDeviceCombiner < RBA::GenericDeviceCombiner"
      },
      {
        "line": 210,
        "text": "  include DeviceCombinerMethods"
      },
      {
        "line": 211,
        "text": ""
      },
      {
        "line": 212,
        "text": "  # Combine only in parallel with preserved terminal polarity:"
      },
      {
        "line": 213,
        "text": "  # TIE->TIE and WELL->WELL. No serial combination for taps."
      },
      {
        "line": 214,
        "text": "  def combine_devices(a, b)"
      },
      {
        "line": 215,
        "text": "    return false unless PARALLEL_RES"
      },
      {
        "line": 216,
        "text": "    return false unless same_net(a, b, 'TIE') && same_net(a, b, 'WELL')"
      },
      {
        "line": 217,
        "text": ""
      },
      {
        "line": 218,
        "text": "    a.set_parameter('A', a.parameter('A') + b.parameter('A'))"
      },
      {
        "line": 219,
        "text": "    a.set_parameter('P', a.parameter('P') + b.parameter('P'))"
      },
      {
        "line": 220,
        "text": ""
      }
    ]
