    "path": "libs.tech/klayout/python/sg13g2_pycell_lib/ihp/utility_functions.py",
    "sha256": "0d5c287ede8decd8b69c8f94bfe72231758e607c02b64650951fcb5be269c861",
    "selected_lines": [
      {
        "line": 520,
        "text": ""
      },
      {
        "line": 521,
        "text": "    caspec = Numeric(techparams[cell+'_caspec'])*1e-12 # specific cap per sq. [um] (float)"
      },
      {
        "line": 522,
        "text": "    cpspec = Numeric(techparams[cell+'_cpspec'])*1e-6  # specific cap. per [um] perimeter (float)"
      },
      {
        "line": 523,
        "text": "    lwd    = Numeric(techparams[cell+'_lwd'])          # line width delta [m] ; 30.7.05 GG: fixed"
      },
      {
        "line": 524,
        "text": ""
      },
      {
        "line": 525,
        "text": "    if type(c) == str :"
      },
      {
        "line": 526,
        "text": "        c = Numeric(c)"
      },
      {
        "line": 527,
        "text": "    if type(l) == str :"
      },
      {
        "line": 528,
        "text": "        l = Numeric(l)"
      },
      {
        "line": 529,
        "text": "    if type(w) == str :"
      },
      {
        "line": 530,
        "text": "        w = Numeric(w)"
      },
      {
        "line": 531,
        "text": ""
      },
      {
        "line": 532,
        "text": "    w = w * 1e6 # um (needed for contact calculation)"
      },
      {
        "line": 533,
        "text": "    l = l * 1e6"
      },
      {
        "line": 551,
        "text": ""
      },
      {
        "line": 552,
        "text": "#***********************************************************************************************************************"
      },
      {
        "line": 553,
        "text": "# CbTapCalc"
      },
      {
        "line": 554,
        "text": "#***********************************************************************************************************************"
      },
      {
        "line": 555,
        "text": "def CbTapCalc(calc, r, l, w, cell) :"
      },
      {
        "line": 556,
        "text": ""
      },
      {
        "line": 557,
        "text": "    global techparams"
      },
      {
        "line": 558,
        "text": ""
      },
      {
        "line": 559,
        "text": "    raspec = Numeric(techparams[cell+'_raspec'])*1.0e12 ;# specific res per sq. [um] (float)"
      },
      {
        "line": 560,
        "text": "    rpspec = Numeric(techparams[cell+'_rpspec'])*1.0e6  ;# specific res. per [um] perimeter (float)"
      },
      {
        "line": 561,
        "text": ""
      },
      {
        "line": 562,
        "text": "    w = w*1.0e6 ;# um (needed for contact calculation)"
      },
      {
        "line": 563,
        "text": "    l = l*1.0e6"
      },
      {
        "line": 564,
        "text": "    a = l*w"
      },
      {
        "line": 565,
        "text": "    p = 2.0*(l+w)"
      },
      {
        "line": 566,
        "text": ""
      },
      {
        "line": 567,
        "text": "    result = 0"
      },
      {
        "line": 568,
        "text": "    if calc == 'R' :"
      },
      {
        "line": 569,
        "text": "        result = 1.0/(1.0/(raspec/a) + 1.0/(rpspec/p))"
      },
      {
        "line": 570,
        "text": "    elif calc == 'l' :"
      },
      {
        "line": 571,
        "text": "        result = (raspec*rpspec- r*raspec*2.0*w)/(r*raspec*2.0+r*rpspec*w)*1.0e-6"
      }
    ]
  },
