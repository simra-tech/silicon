* G1_TRIP kickback: real source (G1_SENSE output through the conditioning divider) and real DAC tap,
* both comparators clocked (soft on cmp_clk, hard on its inverse), 10 MHz. Soft threshold code 153
* (30.0 mV shunt), shunt input set 0.0245 so the soft comparator sits at/near its threshold.
.param VDDA=3 VDD=1.08 VREF=1.04
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib mos_ff_mismatch
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib mos_ff_mismatch
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib res_bcs_mismatch
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib cap_bcs_mismatch
.temp -40.0
* the off switches leave the mux tree nodes floating at DC: give the solver a 1 TOhm path per node
.option rshunt=1e12 gmin=1e-13
.include qualification/joint586-regenpair4-roomcal-s78101-20260923-a/sense.spice
.include qualification/joint586-regenpair4-roomcal-s78101-20260923-a/trip.spice
Vdda vdda 0 dc {VDDA}
Vdd vdd 0 dc {VDD}
Vsh shp 0 dc 0.012749999999999999
Vshn shn 0 dc -0.012749999999999999
XS shp shn vref iptat isense vped vref_buf vdda 0 g1_sense
CL isense 0 300f
* soft code 153 = 1001 1001b (30.0 mV) ; hard code 254 = 1111 1110b (49.8 mV)
Vs0 s0 0 dc 0
Vs1 s1 0 dc 0
Vs2 s2 0 dc 1.0800000000000001
Vs3 s3 0 dc 0
Vs4 s4 0 dc 0
Vs5 s5 0 dc 0
Vs6 s6 0 dc 0
Vs7 s7 0 dc 1.0800000000000001
Vh0 h0 0 dc 1.0800000000000001
Vh1 h1 0 dc 0
Vh2 h2 0 dc 0
Vh3 h3 0 dc 0
Vh4 h4 0 dc 1.0800000000000001
Vh5 h5 0 dc 0
Vh6 h6 0 dc 0
Vh7 h7 0 dc 1.0800000000000001
Vclk clk 0 pulse(0 1.08 20n 0.2n 0.2n 100n 200n)
XT isense vref_buf clk s0 s1 s2 s3 s4 s5 s6 s7 h0 h1 h2 h3 h4 h5 h6 h7 cmp_soft cmp_hard vdd vdda 0 g1_trip
Cs cmp_soft 0 10f
Ch cmp_hard 0 10f
* keep only the nodes of interest (the full 1200-device transient exhausts the output memory)
.save v(clk) v(vref) v(iptat) v(vref_buf) v(xt.icmp) v(xt.vth_soft) v(xt.vth_hard) v(cmp_soft) v(cmp_hard) v(isense) v(xt.cmp_clk_n) v(xt.xch.xp) v(xt.xch.xq) v(xt.xch.xn) v(xt.xch.yn) v(vped) v(shp) v(shn)
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib hbt_bcs_mismatch
.include qualification/joint586-regenpair4-roomcal-s78101-20260923-a/bgr.spice
Vr4 r4 0 0
Xbgr vdda 0 r4 vref iptat pbias pcasc vbe dvbe g1_bgr
.global sub!
Vsub sub! 0 0
.option gmin=1e-15 abstol=1e-14 reltol=1e-5 vntol=1e-7
.option reltol=1e-5 vntol=1e-7 abstol=1e-14
.option method=gear
.nodeset v(vref)=1.035588476178594e+00 v(iptat)=7.300313129137468e-01 v(vref_buf)=1.037402077440337e+00 v(vped)=9.934641950628779e-01 v(isense)=1.518970453538353e+00 v(xt.icmp)=7.589399050758404e-01 v(xt.vth_soft)=7.632528084204684e-01 v(xt.vth_hard)=7.947040300067932e-01
.control
set num_threads=1
set numdgt=15
set filetype=ascii
setseed 78101
reset
echo PHASE0_BEGIN
op
print v(xt.icmp) v(xt.vth_soft) v(xt.vth_hard)
let dqsoft = v(xt.icmp)-v(xt.vth_soft)
let dqhard = v(xt.icmp)-v(xt.vth_hard)
echo QUIET $&dqsoft $&dqhard
echo BIAS_OBSERVATION_OP
print v(vref) v(iptat) v(vref_buf) v(vped) v(shp) v(isense) v(xt.icmp) v(xt.vth_soft) v(xt.vth_hard)
echo BIAS_OBSERVATION_OP_END
echo SHN_OBSERVATION_OP
print v(shn)
echo SHN_OBSERVATION_OP_END
echo NON_BGR_BEFORE_BEGIN
print @n.xs.xr1n0.nr1[nsmm_rsh]
