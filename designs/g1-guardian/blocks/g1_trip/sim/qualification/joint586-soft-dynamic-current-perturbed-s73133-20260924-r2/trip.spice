XDACS vref soft0 soft1 soft2 soft3 soft4 soft5 soft6 soft7 vth_soft vdd vdda vss g1_dac8
XDACH vref hard0 hard1 hard2 hard3 hard4 hard5 hard6 hard7 vth_hard vdd vdda vss g1_dac8
XCHS vth_soft vss cap_cmim w=26u l=26u m=1 mm_ok=1
XCHH vth_hard vss cap_cmim w=26u l=26u m=1 mm_ok=1
XCLKI cmp_clk cmp_clk_n vdd vss g1_inv
XCS icmp vth_soft cmp_clk cmp_soft cmp_soft_n vdd vss g1_cmp
XCH icmp vth_hard cmp_clk_n cmp_hard cmp_hard_n vdd vss g1_cmp_regenpair4
.ends

