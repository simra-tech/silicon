let b_mid=($b_lo+$b_hi)/2
set b_trial=$&b_mid
alter Vod dc=$b_trial
tran .2n .52u 0 0.2n
meas tran q2 find v(q) at=.24u
meas tran q3 find v(q) at=.34u
meas tran q4 find v(q) at=.44u
let b_state=(q2>.6)+(q3>.6)+(q4>.6)
echo BROW seed62001_t0_cm0.75 6 $b_trial $&q2 $&q3 $&q4
set wr_singlescale
set wr_vecnames
wrdata qualification/cmp-cellpex-steady-mc-trap-20260921-a/seed62001_t0_cm0.75_p6.dat v(q) v(qb) v(inp) v(inn) v(clk)
if b_state > 2.5
set b_hi=$b_trial
else
if b_state < .5
set b_lo=$b_trial
else
set b_mixed=1
end
end
end
if $b_mixed < .5
let b_mid=($b_lo+$b_hi)/2
set b_trial=$&b_mid
alter Vod dc=$b_trial
tran .2n .52u 0 0.2n
meas tran q2 find v(q) at=.24u
meas tran q3 find v(q) at=.34u
meas tran q4 find v(q) at=.44u
let b_state=(q2>.6)+(q3>.6)+(q4>.6)
echo BROW seed62001_t0_cm0.75 7 $b_trial $&q2 $&q3 $&q4
