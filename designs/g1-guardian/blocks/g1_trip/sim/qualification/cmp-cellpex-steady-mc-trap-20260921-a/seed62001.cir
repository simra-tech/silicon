if b_state > 2.5
set b_hi=$b_trial
else
if b_state < .5
set b_lo=$b_trial
else
set b_mixed=1
end
end
end
if $b_mixed < .5
let b_mid=($b_lo+$b_hi)/2
set b_trial=$&b_mid
alter Vod dc=$b_trial
tran .2n .52u 0 0.2n
meas tran q2 find v(q) at=.24u
meas tran q3 find v(q) at=.34u
meas tran q4 find v(q) at=.44u
let b_state=(q2>.6)+(q3>.6)+(q4>.6)
echo BROW seed62001_t0_cm0.75 8 $b_trial $&q2 $&q3 $&q4
set wr_singlescale
set wr_vecnames
wrdata qualification/cmp-cellpex-steady-mc-trap-20260921-a/seed62001_t0_cm0.75_p8.dat v(q) v(qb) v(inp) v(inn) v(clk)
if b_state > 2.5
set b_hi=$b_trial
else
if b_state < .5
set b_lo=$b_trial
else
set b_mixed=1
end
end
end
if $b_mixed < .5
let b_mid=($b_lo+$b_hi)/2
set b_trial=$&b_mid
alter Vod dc=$b_trial
tran .2n .52u 0 0.2n
meas tran q2 find v(q) at=.24u
meas tran q3 find v(q) at=.34u
meas tran q4 find v(q) at=.44u
let b_state=(q2>.6)+(q3>.6)+(q4>.6)
echo BROW seed62001_t0_cm0.75 9 $b_trial $&q2 $&q3 $&q4
set wr_singlescale
set wr_vecnames
wrdata qualification/cmp-cellpex-steady-mc-trap-20260921-a/seed62001_t0_cm0.75_p9.dat v(q) v(qb) v(inp) v(inn) v(clk)
if b_state > 2.5
set b_hi=$b_trial
else
if b_state < .5
set b_lo=$b_trial
else
set b_mixed=1
end
end
end
if $b_mixed < .5
let b_mid=($b_lo+$b_hi)/2
set b_trial=$&b_mid
alter Vod dc=$b_trial
tran .2n .52u 0 0.2n
meas tran q2 find v(q) at=.24u
meas tran q3 find v(q) at=.34u
meas tran q4 find v(q) at=.44u
let b_state=(q2>.6)+(q3>.6)+(q4>.6)
echo BROW seed62001_t0_cm0.75 10 $b_trial $&q2 $&q3 $&q4
set wr_singlescale
set wr_vecnames
wrdata qualification/cmp-cellpex-steady-mc-trap-20260921-a/seed62001_t0_cm0.75_p10.dat v(q) v(qb) v(inp) v(inn) v(clk)
if b_state > 2.5
set b_hi=$b_trial
else
if b_state < .5
set b_lo=$b_trial
else
set b_mixed=1
end
end
end
echo BRACKET seed62001_t0_cm0.75 $b_lo $b_hi $b_mixed $b_endpoints
echo FINGERPRINT seed62001_t0_cm0.75
print @n.x1.xm6.nsg13_lv_nmos[w]
print @n.x1.xm6.nsg13_lv_nmos[l]
print @n.x1.xm6.nsg13_lv_nmos[delvto]
print @n.x1.xm6.nsg13_lv_nmos[factuo]
print @n.x1.xm7.nsg13_lv_nmos[w]
print @n.x1.xm7.nsg13_lv_nmos[l]
print @n.x1.xm7.nsg13_lv_nmos[delvto]
print @n.x1.xm7.nsg13_lv_nmos[factuo]
