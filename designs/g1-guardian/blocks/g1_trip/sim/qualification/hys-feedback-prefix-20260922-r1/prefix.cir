print @n.xt.xcs.xm1.nsg13_lv_nmos[w]
print @n.xt.xcs.xm1.nsg13_lv_nmos[l]
print @n.xt.xcs.xm1.nsg13_lv_nmos[delvto]
print @n.xt.xcs.xm1.nsg13_lv_nmos[factuo]
print @n.xt.xch.xm1.nsg13_lv_nmos[w]
print @n.xt.xch.xm1.nsg13_lv_nmos[l]
print @n.xt.xch.xm1.nsg13_lv_nmos[delvto]
print @n.xt.xch.xm1.nsg13_lv_nmos[factuo]
print @n.xbgr.xm34.nsg13_hv_nmos[delvto]
print @n.xbgr.xr16.nr1[nsmm_rsh]
print @q.xbgr.xq56.qnpn13g2[area]
tran .2n 0.9u 0 .2n
echo HYS_PARAMETERS_AFTER
print @n.xs.xota.xm1.nsg13_hv_pmos[w]
print @n.xs.xota.xm1.nsg13_hv_pmos[l]
print @n.xs.xota.xm1.nsg13_hv_pmos[delvto]
print @n.xs.xota.xm1.nsg13_hv_pmos[factuo]
print @n.xs.xref.xm1.nsg13_hv_pmos[w]
print @n.xs.xref.xm1.nsg13_hv_pmos[l]
print @n.xs.xref.xm1.nsg13_hv_pmos[delvto]
print @n.xs.xref.xm1.nsg13_hv_pmos[factuo]
print @n.xt.xdacs.xms7_0a.nsg13_hv_nmos[w]
print @n.xt.xdacs.xms7_0a.nsg13_hv_nmos[l]
print @n.xt.xdacs.xms7_0a.nsg13_hv_nmos[delvto]
print @n.xt.xdacs.xms7_0a.nsg13_hv_nmos[factuo]
print @n.xt.xdach.xms7_0a.nsg13_hv_nmos[w]
print @n.xt.xdach.xms7_0a.nsg13_hv_nmos[l]
print @n.xt.xdach.xms7_0a.nsg13_hv_nmos[delvto]
print @n.xt.xdach.xms7_0a.nsg13_hv_nmos[factuo]
print @n.xt.xcs.xm1.nsg13_lv_nmos[w]
print @n.xt.xcs.xm1.nsg13_lv_nmos[l]
print @n.xt.xcs.xm1.nsg13_lv_nmos[delvto]
print @n.xt.xcs.xm1.nsg13_lv_nmos[factuo]
print @n.xt.xch.xm1.nsg13_lv_nmos[w]
print @n.xt.xch.xm1.nsg13_lv_nmos[l]
print @n.xt.xch.xm1.nsg13_lv_nmos[delvto]
print @n.xt.xch.xm1.nsg13_lv_nmos[factuo]
print @n.xbgr.xm34.nsg13_hv_nmos[delvto]
print @n.xbgr.xr16.nr1[nsmm_rsh]
print @q.xbgr.xq56.qnpn13g2[area]
set wr_singlescale
set wr_vecnames
wrdata qualification/hys-feedback-prefix-20260922-r1/prefix.dat v(osc) v(en) v(cmp_soft) v(cmp_hard) v(clk) v(s7) v(s6) v(s5) v(s4) v(s3) v(s2) v(s1) v(s0) v(h7) v(h6) v(h5) v(h4) v(h3) v(h2) v(h1) v(h0) v(count23) v(count22) v(count21) v(count20) v(count19) v(count18) v(count17) v(count16) v(count15) v(count14) v(count13) v(count12) v(count11) v(count10) v(count9) v(count8) v(count7) v(count6) v(count5) v(count4) v(count3) v(count2) v(count1) v(count0) v(sync_soft) v(sync_hard) v(soft_mask) v(soft_armed) v(trip) v(rst_n) v(shp) v(vref) v(iptat) v(vref_buf) v(vped) v(isense) v(xt.icmp) v(xt.vth_soft) v(xt.vth_hard)
echo HYS_ANALOG_COMPLETE
quit 0
.endc
.end
