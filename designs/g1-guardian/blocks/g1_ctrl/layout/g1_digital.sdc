###############################################################################
# Created by write_sdc
###############################################################################
current_design g1_digital
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name osc_clk -period 100.0000 [get_ports {osc_clk}]
set_clock_transition 0.3000 [get_clocks {osc_clk}]
set_clock_uncertainty -setup 0.5000 osc_clk
set_clock_uncertainty -hold 0.0500 osc_clk
set_propagated_clock [get_clocks {osc_clk}]
create_clock -name sclk -period 100.0000 [get_ports {sclk}]
set_clock_transition 0.3000 [get_clocks {sclk}]
set_clock_uncertainty -setup 0.5000 sclk
set_clock_uncertainty -hold 0.0500 sclk
set_propagated_clock [get_clocks {sclk}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {osc_clk}]\
 -group [get_clocks {sclk}]
set_input_delay 2.0000 -clock [get_clocks {sclk}] -min -add_delay [get_ports {sdi}]
set_input_delay 20.0000 -clock [get_clocks {sclk}] -max -add_delay [get_ports {sdi}]
set_output_delay 0.0000 -clock [get_clocks {osc_clk}] -min -add_delay [get_ports {bgr_r4}]
set_output_delay 20.0000 -clock [get_clocks {osc_clk}] -max -add_delay [get_ports {bgr_r4}]
