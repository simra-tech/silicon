XIO_BOND_pad19_g_shared G_SHARED bondpad_70x70_tm1
XIO_BOND_pad20_d_std D_STD bondpad_70x70_tm1
XIO_BOND_pad21_d_elt D_ELT bondpad_70x70_tm1
XIO_BOND_pad22_hbt_e HBT_E bondpad_70x70_tm1
