+ v(xchip.i_core_vref_buf) v(xchip.i_core_unused_vped)
.control
set filetype=ascii
set wr_singlescale
set wr_vecnames
tran 2e-08 44u 0 1e-09
* quiet operating values after the register write(s): window averages over the last 2 us before the load
* event (comparator kickback averaged out); single-instant samples at t_cfg + 1 us kept as *_inst
meas tran vref_q avg v(xchip.i_core_vref) from=28u to=30u
meas tran isense_q avg v(xchip.i_core_isense) from=28u to=30u
meas tran icmp_q avg v(xchip.xi_core_u_trip.icmp) from=28u to=30u
meas tran vths_q avg v(xchip.xi_core_u_trip.vth_soft) from=28u to=30u
meas tran vthh_q avg v(xchip.xi_core_u_trip.vth_hard) from=28u to=30u
meas tran vref_i find v(xchip.i_core_vref) at=26.8451u
meas tran isense_i find v(xchip.i_core_isense) at=26.8451u
meas tran icmp_i find v(xchip.xi_core_u_trip.icmp) at=26.8451u
meas tran vths_i find v(xchip.xi_core_u_trip.vth_soft) at=26.8451u
meas tran vthh_i find v(xchip.xi_core_u_trip.vth_hard) at=26.8451u
meas tran iload_q find i(vim) at=26.8451u
meas tran gate_q find v(gate) at=26.8451u
meas tran fastq find v(xchip.i_core_fast_en) at=26.8451u
meas tran t_inrush_off when v(xchip.xi_core_u_digital.inrush_active)=0.6 fall=1 from=3u
meas tran inrush_q find v(xchip.xi_core_u_digital.inrush_active) at=26.8451u
meas tran softarmed_end find v(xchip.xi_core_u_digital.soft_armed) at=44u
let cs_v = 1*(v(xchip.i_core_dac_soft_0_) gt 0.6) + 2*(v(xchip.i_core_dac_soft_1_) gt 0.6) + 4*(v(xchip.i_core_dac_soft_2_) gt 0.6) + 8*(v(xchip.i_core_dac_soft_3_) gt 0.6) + 16*(v(xchip.i_core_dac_soft_4_) gt 0.6) + 32*(v(xchip.i_core_dac_soft_5_) gt 0.6) + 64*(v(xchip.i_core_dac_soft_6_) gt 0.6) + 128*(v(xchip.i_core_dac_soft_7_) gt 0.6)
let ch_v = 1*(v(xchip.i_core_dac_hard_0_) gt 0.6) + 2*(v(xchip.i_core_dac_hard_1_) gt 0.6) + 4*(v(xchip.i_core_dac_hard_2_) gt 0.6) + 8*(v(xchip.i_core_dac_hard_3_) gt 0.6) + 16*(v(xchip.i_core_dac_hard_4_) gt 0.6) + 32*(v(xchip.i_core_dac_hard_5_) gt 0.6) + 64*(v(xchip.i_core_dac_hard_6_) gt 0.6) + 128*(v(xchip.i_core_dac_hard_7_) gt 0.6)
meas tran code_soft find cs_v at=26.8451u
meas tran code_hard find ch_v at=26.8451u
let t_inrush_off_us = t_inrush_off*1e6
echo "QUIET window_us=28-30 vref=" $&vref_q " isense=" $&isense_q " icmp=" $&icmp_q " vth_soft=" $&vths_q " vth_hard=" $&vthh_q " vref_inst=" $&vref_i " isense_inst=" $&isense_i " icmp_inst=" $&icmp_i " vth_soft_inst=" $&vths_i " vth_hard_inst=" $&vthh_i " iload_A=" $&iload_q " gate=" $&gate_q " code_soft=" $&code_soft " code_hard=" $&code_hard " fast_en=" $&fastq " inrush_active=" $&inrush_q " t_inrush_off_us=" $&t_inrush_off_us " soft_armed_end=" $&softarmed_end
* clocks: 20 oscillator periods and 10 strobe periods after the configuration
meas tran tosc1 when v(xchip.i_core_osc_clk)=0.6 rise=1 from=25.8451u
meas tran tosc2 when v(xchip.i_core_osc_clk)=0.6 rise=21 from=25.8451u
let fosc_mhz = 20e-6/(tosc2 - tosc1)
meas tran tcc1 when v(xchip.i_core_cmp_clk)=0.6 rise=1 from=25.8451u
meas tran tcc2 when v(xchip.i_core_cmp_clk)=0.6 rise=11 from=25.8451u
let fcmp_mhz = 10e-6/(tcc2 - tcc1)
echo "CLOCK f_osc_MHz=" $&fosc_mhz " f_cmp_MHz=" $&fcmp_mhz " (RTL clock: ideal source at the block-simulated frequency)"
* supply currents averaged over the quiet armed window
let i_vdda = i(vma)
meas tran ia_vdda avg i_vdda from=27.8451u to=30u
let ua_vdda = ia_vdda*1e6
let i_iovdd = i(vmi)
meas tran ia_iovdd avg i_iovdd from=27.8451u to=30u
let ua_iovdd = ia_iovdd*1e6
let i_vdd = -i(v12)
meas tran ia_vdd avg i_vdd from=27.8451u to=30u
let ua_vdd = ia_vdd*1e6
let i_bgr = i(v.xchip.vm_bgr)
meas tran ia_bgr avg i_bgr from=27.8451u to=30u
let ua_bgr = ia_bgr*1e6
let i_sense = i(v.xchip.vm_sense)
meas tran ia_sense avg i_sense from=27.8451u to=30u
let ua_sense = ia_sense*1e6
let i_tripa = i(v.xchip.vm_tripa)
meas tran ia_tripa avg i_tripa from=27.8451u to=30u
let ua_tripa = ia_tripa*1e6
let i_tripd = i(v.xchip.vm_tripd)
meas tran ia_tripd avg i_tripd from=27.8451u to=30u
let ua_tripd = ia_tripd*1e6
let i_osc = i(v.xchip.vm_osc)
meas tran ia_osc avg i_osc from=27.8451u to=30u
let ua_osc = ia_osc*1e6
let i_gatea = i(v.xchip.vm_gatea)
meas tran ia_gatea avg i_gatea from=27.8451u to=30u
let ua_gatea = ia_gatea*1e6
let i_gated = i(v.xchip.vm_gated)
meas tran ia_gated avg i_gated from=27.8451u to=30u
let ua_gated = ia_gated*1e6
echo "SUPPLY_uA window=27.8451-30us VDDA=" $&ua_vdda " IOVDD=" $&ua_iovdd " VDD=" $&ua_vdd " | bgr=" $&ua_bgr " sense=" $&ua_sense " trip_3v3=" $&ua_tripa " trip_1v2=" $&ua_tripd " osc=" $&ua_osc " gate_3v3=" $&ua_gatea " gate_1v2=" $&ua_gated
* G1_T2F: output frequency (rising 0.6 V crossings) and supply currents over the quiet window
meas tran t2f_t1 when v(xchip.i_core_temp_out_o)=0.6 rise=1 from=27.8451u to=30u
meas tran t2f_t2 when v(xchip.i_core_temp_out_o)=0.6 rise=3 from=27.8451u to=30u
let t2f_mhz = 2e-6/(t2f_t2 - t2f_t1)
meas tran ia_t2f avg i(v.xchip.vm_t2f) from=27.8451u to=30u
let ua_t2f = ia_t2f*1e6
meas tran ia_t2fd avg i(v.xchip.vm_t2fd) from=27.8451u to=30u
let ua_t2fd = ia_t2fd*1e6
meas tran ia_ls avg i(v.xchip.vm_ls) from=27.8451u to=30u
let ua_ls = ia_ls*1e6
meas tran ia_lsd avg i(v.xchip.vm_lsd) from=27.8451u to=30u
let ua_lsd = ia_lsd*1e6
echo "T2F window=27.8451-30us f_MHz=" $&t2f_mhz " periods=2 vdda_t2f_uA=" $&ua_t2f " vdd12_t2f_uA=" $&ua_t2fd " vdda_ls_uA=" $&ua_ls " vdd_ls_uA=" $&ua_lsd
* trip evaluation after the load event at T_STEP
let tstep_s = 30u
meas tran tripped_max max v(xchip.i_core_tripped) from=25.8451u to=44u
meas tran tripped_pre max v(xchip.i_core_tripped) from=25.8451u to=30u
meas tran gate_min min v(gate) from=30u to=44u
meas tran gate_end find v(gate) at=44u
meas tran ipk max i(vim) from=30u to=44u
meas tran i_end find i(vim) at=44u
meas tran isense_pk max v(xchip.i_core_isense) from=30u to=44u
meas tran cause1e find v(xchip.i_core_trip_cause_1_) at=44u
meas tran cause0e find v(xchip.i_core_trip_cause_0_) at=44u
meas tran fault_end find v(fault_n) at=44u
let sp_v = 1*(v(xchip.xi_core_u_digital.sp0) gt 0.6) + 2*(v(xchip.xi_core_u_digital.sp1) gt 0.6) + 4*(v(xchip.xi_core_u_digital.sp2) gt 0.6) + 8*(v(xchip.xi_core_u_digital.sp3) gt 0.6) + 16*(v(xchip.xi_core_u_digital.sp4) gt 0.6) + 32*(v(xchip.xi_core_u_digital.sp5) gt 0.6) + 64*(v(xchip.xi_core_u_digital.sp6) gt 0.6) + 128*(v(xchip.xi_core_u_digital.sp7) gt 0.6) + 256*(v(xchip.xi_core_u_digital.sp8) gt 0.6) + 512*(v(xchip.xi_core_u_digital.sp9) gt 0.6) + 1024*(v(xchip.xi_core_u_digital.sp10) gt 0.6) + 2048*(v(xchip.xi_core_u_digital.sp11) gt 0.6) + 4096*(v(xchip.xi_core_u_digital.sp12) gt 0.6) + 8192*(v(xchip.xi_core_u_digital.sp13) gt 0.6) + 16384*(v(xchip.xi_core_u_digital.sp14) gt 0.6) + 32768*(v(xchip.xi_core_u_digital.sp15) gt 0.6)
meas tran soft_peak find sp_v at=44u
let cause = 2*(cause1e gt 0.6) + (cause0e gt 0.6)
echo "NO_TRIP_EXPECTED tripped_max=" $&tripped_max " gate_min=" $&gate_min " gate_end=" $&gate_end " ipk_A=" $&ipk " i_end_A=" $&i_end " cause=" $&cause " fault_n_end=" $&fault_end " soft_peak=" $&soft_peak
let qi = integ(i(vim))
meas tran q_step find qi at=30u
meas tran q_end find qi at=44u
let q_passed = q_end - q_step
echo "CHARGE after_event_As=" $&q_passed
