25769e-05 0 2.42455791915e-05 0 2.42455791915e-05 0 2.42464791915e-05 1.485 2.42466791915e-05 1.815 2.42475791915e-05 3.3 2.4346395806e-05 3.3 2.4347295806e-05 1.815 2.4347495806e-05 1.485 2.4348395806e-05 0 2.44472124206e-05 0 2.44472124206e-05 0 2.44481124206e-05 1.485 2.44483124206e-05 1.815 2.44492124206e-05 3.3 2.45480290352e-05 3.3 2.45489290352e-05 1.815 2.45491290352e-05 1.485 2.45500290352e-05 0)
Vsdi sdi_pad 0 pwl(0 0 1.80957657022e-05 0 1.89022986188e-05 0 1.89031986188e-05 1.485 1.89033986188e-05 1.815 1.89042986188e-05 3.3 1.9103931848e-05 3.3 1.9104831848e-05 1.815 1.9105031848e-05 1.485 1.9105931848e-05 0 2.21284302853e-05 0 2.21293302853e-05 1.485 2.21295302853e-05 1.815 2.21304302853e-05 3.3 2.23300635145e-05 3.3 2.23309635145e-05 1.815 2.23311635145e-05 1.485 2.23320635145e-05 0 2.25316967436e-05 0 2.25325967436e-05 1.485 2.25327967436e-05 1.815 2.25336967436e-05 3.3 2.29349632019e-05 3.3 2.29358632019e-05 1.815 2.29360632019e-05 1.485 2.29369632019e-05 0 2.33382296602e-05 0 2.33391296602e-05 1.485 2.33393296602e-05 1.815 2.33402296602e-05 3.3 2.35398628894e-05 3.3 2.35407628894e-05 1.815 2.35409628894e-05 1.485 2.35418628894e-05 0 2.41447625769e-05 0 2.41456625769e-05 1.485 2.41458625769e-05 1.815 2.41467625769e-05 3.3 2.45480290352e-05 3.3 2.45489290352e-05 1.815 2.45491290352e-05 1.485 2.45500290352e-05 0)
Cw_en en_core 0 20f
Cw_sclk sclk_core 0 20f
Cw_sdi sdi_core 0 20f
* the RTL reads EN / SCLK / SDI as a digital stimulus (XSPICE d_source) with the same edge times as the pad
* PWLs (event at the middle of each edge); the pad models still drive en_core for G1_GATE (README, "Numerical notes")
.model dsrc d_source(input_file="/work/build/g1_top/stim_c_fast_sch_tl_tt_27C.txt")
adsrc [d_en d_sclk d_sdi] dsrc
* ---- oscillator enable gate (testbench): RTL osc_en, released at 0.1 us
Bosc osc_en_g 0 V = v(osc_en) * min(1, max(0, (time - 0.1u) / 50n))
* ---- analog chain at transistor level (per-block supply pins through 0 V sources for the current table)
Vr4 r4 0 dc 0
Vm_bgr vdda vdda_bgr dc 0
XBGR vdda_bgr 0 r4 vref iptat pbias pcasc vbe dvbe g1_bgr
Vm_sense vdda vdda_sense dc 0
XSENSE sense_p sense_n vref iptat isense vped vref_buf vdda_sense 0 g1_sense
Cw_isense isense 0 300f
Vm_tripa vdda vdda_trip dc 0
Vm_tripd vdd vdd_trip dc 0
XTRIP isense vref_buf cmp_clk soft0 soft1 soft2 soft3 soft4 soft5 soft6 soft7 hard0 hard1 hard2 hard3 hard4 hard5 hard6 hard7 cmp_soft cmp_hard vdd_trip vdda_trip 0 g1_trip
Cw_soft cmp_soft 0 20f
Cw_hard cmp_hard 0 20f
Vm_osc vdd vdd_osc dc 0
* the clock delivered to the digital macro is an ideal source at the block-simulated G1_OSC frequency;
* G1_OSC is not in this deck (README, "Numerical notes": with the transistor-level oscillator on the
* chip supply the event-driven solver aborts; case osc runs it in the chip context without G1_TRIP)
Rosc_dummy vdd_osc 0 1e12
Vosc_i osc_i 0 pulse(0 1.2 1e-07 1n 1n 4.94083e-08 1.00817e-07)
Bosc_clk osc_clk 0 V = v(osc_i) * (0.5 + 0.5*tanh((v(osc_en_g) - 0.6)/0.05))
Cw_clk osc_clk 0 100f
Vm_gatea vdda vdda_gate dc 0
Vm_gated vdd vdd_gate dc 0
XGATE trip_d clr_d fast_en cmp_hard en_core gate_core fault_core tripped vdd_gate vdda_gate 0 g1_gate
Cw_tripped tripped 0 20f
* ---- digital macro: the real RTL through XSPICE d_cosim (Icarus Verilog shim ivlng)
.model adc adc_bridge(in_low=0.55 in_high=0.65 rise_delay=1e-12 fall_delay=1e-12)
.model dac dac_bridge(out_low=0 out_high=1.2 out_undef=0.6 t_rise=0.3n t_fall=0.3n)
.model rtl d_cosim simulation="ivlng" sim_args=["/work/build/g1_top/g1_dig_cosim.vvp"]
aadc [osc_clk cmp_soft cmp_hard tripped] [d_osc_clk d_cmp_soft d_cmp_hard d_tripped] adc
adig [d_osc_clk d_en d_sclk d_sdi d_cmp_soft d_cmp_hard d_tripped] [d_cmp_clk d_s7 d_s6 d_s5 d_s4 d_s3 d_s2 d_s1 d_s0 d_h7 d_h6 d_h5 d_h4 d_h3 d_h2 d_h1 d_h0 d_trip_d d_clr_d d_fast_en d_osc_en d_t3 d_t2 d_t1 d_t0 d_trip d_gate_en d_cause1 d_cause0 d_sdo d_sp15 d_sp14 d_sp13 d_sp12 d_sp11 d_sp10 d_sp9 d_sp8 d_sp7 d_sp6 d_sp5 d_sp4 d_sp3 d_sp2 d_sp1 d_sp0 d_inrush d_softarmed] rtl
adac [d_cmp_clk d_s7 d_s6 d_s5 d_s4 d_s3 d_s2 d_s1 d_s0 d_h7 d_h6 d_h5 d_h4 d_h3 d_h2 d_h1 d_h0 d_trip_d d_clr_d d_fast_en d_osc_en d_t3 d_t2 d_t1 d_t0 d_trip d_gate_en d_cause1 d_cause0 d_sdo d_sp15 d_sp14 d_sp13 d_sp12 d_sp11 d_sp10 d_sp9 d_sp8 d_sp7 d_sp6 d_sp5 d_sp4 d_sp3 d_sp2 d_sp1 d_sp0 d_inrush d_softarmed] [cmp_clk soft7 soft6 soft5 soft4 soft3 soft2 soft1 soft0 hard7 hard6 hard5 hard4 hard3 hard2 hard1 hard0 trip_d clr_d fast_en osc_en trim3 trim2 trim1 trim0 dig_trip dig_gate_en cause1 cause0 sdo sp15 sp14 sp13 sp12 sp11 sp10 sp9 sp8 sp7 sp6 sp5 sp4 sp3 sp2 sp1 sp0 inrush_active soft_armed] dac
.save v(gate) v(gfet) v(tripped) v(isense) v(cmp_soft) v(cmp_hard) v(trip_d) v(clr_d) v(fast_en) v(osc_clk) v(cmp_clk)
+ v(vref) v(iptat) v(en_core) v(shp) v(shn) v(fault_n) v(gate_core) v(vdda) v(vdd) v(iovdd) v(iprof) v(osc_en_g)
+ v(xtrip.icmp) v(xtrip.vth_soft) v(xtrip.vth_hard) v(dig_trip) v(cause1) v(cause0) v(sclk_pad) v(sdi_pad)
+ v(soft0) v(soft1) v(soft2) v(soft3) v(soft4) v(soft5) v(soft6) v(soft7) v(hard0) v(hard1) v(hard2) v(hard3) v(hard4) v(hard5) v(hard6) v(hard7)
+ v(sp0) v(sp1) v(sp2) v(sp3) v(sp4) v(sp5) v(sp6) v(sp7) v(sp8) v(sp9) v(sp10) v(sp11) v(sp12) v(sp13) v(sp14) v(sp15) v(inrush_active) v(soft_armed)
+ i(vim) i(vma) i(vmi) i(v12) i(vm_bgr) i(vm_sense) i(vm_tripa) i(vm_tripd) i(vm_osc) i(vm_gatea) i(vm_gated)
+ v(vref_buf) v(vped)
.control
set filetype=ascii
set wr_singlescale
set wr_vecnames
tran 2e-08 36u 0 5e-09
* quiet operating values after the register write(s)
meas tran vref_q find v(vref) at=26.548u
meas tran isense_q find v(isense) at=26.548u
meas tran icmp_q find v(xtrip.icmp) at=26.548u
meas tran vths_q find v(xtrip.vth_soft) at=26.548u
meas tran vthh_q find v(xtrip.vth_hard) at=26.548u
meas tran iload_q find i(vim) at=26.548u
meas tran gate_q find v(gate) at=26.548u
meas tran fastq find v(fast_en) at=26.548u
meas tran t_inrush_off when v(inrush_active)=0.6 fall=1 from=3u
meas tran inrush_q find v(inrush_active) at=26.548u
meas tran softarmed_end find v(soft_armed) at=36u
let cs_v = 1*(v(soft0) gt 0.6) + 2*(v(soft1) gt 0.6) + 4*(v(soft2) gt 0.6) + 8*(v(soft3) gt 0.6) + 16*(v(soft4) gt 0.6) + 32*(v(soft5) gt 0.6) + 64*(v(soft6) gt 0.6) + 128*(v(soft7) gt 0.6)
let ch_v = 1*(v(hard0) gt 0.6) + 2*(v(hard1) gt 0.6) + 4*(v(hard2) gt 0.6) + 8*(v(hard3) gt 0.6) + 16*(v(hard4) gt 0.6) + 32*(v(hard5) gt 0.6) + 64*(v(hard6) gt 0.6) + 128*(v(hard7) gt 0.6)
meas tran code_soft find cs_v at=26.548u
meas tran code_hard find ch_v at=26.548u
let t_inrush_off_us = t_inrush_off*1e6
echo "QUIET vref=" $&vref_q " isense=" $&isense_q " icmp=" $&icmp_q " vth_soft=" $&vths_q " vth_hard=" $&vthh_q " iload_A=" $&iload_q " gate=" $&gate_q " code_soft=" $&code_soft " code_hard=" $&code_hard " fast_en=" $&fastq " inrush_active=" $&inrush_q " t_inrush_off_us=" $&t_inrush_off_us " soft_armed_end=" $&softarmed_end
* clocks: 20 oscillator periods and 10 strobe periods after the configuration
meas tran tosc1 when v(osc_clk)=0.6 rise=1 from=25.548u
meas tran tosc2 when v(osc_clk)=0.6 rise=21 from=25.548u
let fosc_mhz = 20e-6/(tosc2 - tosc1)
meas tran tcc1 when v(cmp_clk)=0.6 rise=1 from=25.548u
meas tran tcc2 when v(cmp_clk)=0.6 rise=11 from=25.548u
let fcmp_mhz = 10e-6/(tcc2 - tcc1)
echo "CLOCK f_osc_MHz=" $&fosc_mhz " f_cmp_MHz=" $&fcmp_mhz " (RTL clock: ideal source at the block-simulated frequency)"
* supply currents averaged over the quiet armed window
let i_vdda = i(vma)
meas tran ia_vdda avg i_vdda from=27.548u to=30u
let ua_vdda = ia_vdda*1e6
let i_iovdd = i(vmi)
meas tran ia_iovdd avg i_iovdd from=27.548u to=30u
let ua_iovdd = ia_iovdd*1e6
let i_vdd = -i(v12)
meas tran ia_vdd avg i_vdd from=27.548u to=30u
let ua_vdd = ia_vdd*1e6
let i_bgr = i(vm_bgr)
meas tran ia_bgr avg i_bgr from=27.548u to=30u
let ua_bgr = ia_bgr*1e6
let i_sense = i(vm_sense)
meas tran ia_sense avg i_sense from=27.548u to=30u
let ua_sense = ia_sense*1e6
let i_tripa = i(vm_tripa)
meas tran ia_tripa avg i_tripa from=27.548u to=30u
let ua_tripa = ia_tripa*1e6
let i_tripd = i(vm_tripd)
meas tran ia_tripd avg i_tripd from=27.548u to=30u
let ua_tripd = ia_tripd*1e6
let i_osc = i(vm_osc)
meas tran ia_osc avg i_osc from=27.548u to=30u
let ua_osc = ia_osc*1e6
let i_gatea = i(vm_gatea)
meas tran ia_gatea avg i_gatea from=27.548u to=30u
let ua_gatea = ia_gatea*1e6
let i_gated = i(vm_gated)
meas tran ia_gated avg i_gated from=27.548u to=30u
let ua_gated = ia_gated*1e6
echo "SUPPLY_uA window=27.548-30us VDDA=" $&ua_vdda " IOVDD=" $&ua_iovdd " VDD=" $&ua_vdd " | bgr=" $&ua_bgr " sense=" $&ua_sense " trip_3v3=" $&ua_tripa " trip_1v2=" $&ua_tripd " osc=" $&ua_osc " gate_3v3=" $&ua_gatea " gate_1v2=" $&ua_gated
* trip evaluation after the load event at T_STEP
let tstep_s = 30u
meas tran tripped_max max v(tripped) from=25.548u to=36u
meas tran tripped_pre max v(tripped) from=25.548u to=30u
meas tran t_tripped when v(tripped)=0.6 rise=1 from=30u
meas tran t_trip_d when v(trip_d)=0.6 rise=1 from=30u
meas tran t_gate1v when v(gate)=1.0 fall=1 from=30u
meas tran t_gate03 when v(gate)=0.33 fall=1 from=30u
meas tran gate_min min v(gate) from=30u to=36u
meas tran gate_end find v(gate) at=36u
meas tran ipk max i(vim) from=30u to=36u
meas tran i_end find i(vim) at=36u
meas tran isense_pk max v(isense) from=30u to=36u
meas tran cause1e find v(cause1) at=36u
meas tran cause0e find v(cause0) at=36u
meas tran fault_end find v(fault_n) at=36u
let sp_v = 1*(v(sp0) gt 0.6) + 2*(v(sp1) gt 0.6) + 4*(v(sp2) gt 0.6) + 8*(v(sp3) gt 0.6) + 16*(v(sp4) gt 0.6) + 32*(v(sp5) gt 0.6) + 64*(v(sp6) gt 0.6) + 128*(v(sp7) gt 0.6) + 256*(v(sp8) gt 0.6) + 512*(v(sp9) gt 0.6) + 1024*(v(sp10) gt 0.6) + 2048*(v(sp11) gt 0.6) + 4096*(v(sp12) gt 0.6) + 8192*(v(sp13) gt 0.6) + 16384*(v(sp14) gt 0.6) + 32768*(v(sp15) gt 0.6)
meas tran soft_peak find sp_v at=36u
let cause = 2*(cause1e gt 0.6) + (cause0e gt 0.6)
let dt_gate1v_us = (t_gate1v - tstep_s)*1e6
let dt_gate03_us = (t_gate03 - tstep_s)*1e6
let dt_tripped_us = (t_tripped - tstep_s)*1e6
let dt_trip_d_us = (t_trip_d - tstep_s)*1e6
echo "TRIP tripped_max=" $&tripped_max " tripped_before_event=" $&tripped_pre " t_tripped_us=" $&dt_tripped_us " t_trip_d_us=" $&dt_trip_d_us " t_gate_1V_us=" $&dt_gate1v_us " t_gate_0.33V_us=" $&dt_gate03_us " gate_min=" $&gate_min " gate_end=" $&gate_end " ipk_A=" $&ipk " i_end_A=" $&i_end " isense_pk=" $&isense_pk " cause=" $&cause " fault_n_end=" $&fault_end " soft_peak=" $&soft_peak
let qi = integ(i(vim))
meas tran q_step find qi at=30u
meas tran q_end find qi at=36u
let q_passed = q_end - q_step
echo "CHARGE after_event_As=" $&q_passed
linearize v(gate) v(gfet) v(tripped) v(isense) v(cmp_soft) v(cmp_hard) v(trip_d) v(osc_clk) v(vref) v(en_core) v(shp) v(fault_n) v(vdda) v(vdd) v(iprof) v(xtrip.icmp) v(xtrip.vth_soft) v(xtrip.vth_hard) v(dig_trip) i(vim) i(vma) i(vmi) i(v12)
wrdata /work/build/g1_top/waves_c_fast_sch_tl_tt_27C.txt v(gate) v(gfet) v(tripped) v(isense) v(cmp_soft) v(cmp_hard) v(trip_d) v(osc_clk) v(vref) v(en_core) v(shp) v(fault_n) v(vdda) v(vdd) v(iprof) v(xtrip.icmp) v(xtrip.vth_soft) v(xtrip.vth_hard) v(dig_trip) i(vim) i(vma) i(vmi) i(v12)
.endc
.end
