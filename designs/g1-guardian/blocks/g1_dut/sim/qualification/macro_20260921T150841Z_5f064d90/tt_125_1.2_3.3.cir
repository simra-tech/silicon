.include /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spi
XP_b b_pad b_unused vdd 0 vdda 0 sg13g2_IOPadAnalog
R_b b_pad b_wire 100.0
VM_b b_wire b 0
XP_c c_pad c_unused vdd 0 vdda 0 sg13g2_IOPadAnalog
