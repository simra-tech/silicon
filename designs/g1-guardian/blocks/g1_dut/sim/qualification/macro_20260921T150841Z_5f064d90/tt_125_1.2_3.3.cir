VM_e e_wire e 0
X1 b c e 0 g1_dut_macro
Vb b_pad 0 0.7
Vc c_pad 0 1.0
Ve e_pad 0 0
.control
set num_threads=1
set numdgt=15
set wr_singlescale
set wr_vecnames
dc Vb 0.30 0.85 0.001
wrdata /work/designs/g1-guardian/blocks/g1_dut/sim/qualification/macro_20260921T150841Z_5f064d90/tt_125_1.2_3.3.tsv v(b) v(c) v(e) i(vm_b) i(vm_c) i(vm_e) i(vb) i(vc) i(ve) i(vdd) i(vdda)
quit
.endc
.end
