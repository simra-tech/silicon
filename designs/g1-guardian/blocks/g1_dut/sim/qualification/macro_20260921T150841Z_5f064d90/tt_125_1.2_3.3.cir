* dut extracted macro characterization
.include /work/designs/g1-guardian/blocks/g1_dut/reports/flat-pex-20260921T150414Z_3db2c2ca/ngspice_pex.spice
.temp 125
.option method=gear reltol=1e-4 abstol=1e-16 vntol=1e-7 gmin=1e-16
.global sub!
Vsub sub! 0 0
Vdd vdd 0 1.2
Vdda vdda 0 3.3
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib mos_tt
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib mos_tt
