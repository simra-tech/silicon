  "stock_deck_excerpts": [
    {
      "path": "libs.tech/klayout/tech/lvs/rule_decks/mos_extraction.lvs",
      "sha256": "dea4df60fced945fb182e2d2e511a73b6b2863d70acfbbb9875e8535bc0caa49",
      "first_line": 35,
      "last_line": 74,
      "text": "extract_devices(mos4('sg13_lv_nmos'),\n                { 'SD' => nsd_fet,\n                  'G' => ngate_lv,\n                  'tS' => nsd_fet,\n                  'tD' => nsd_fet,\n                  'tG' => poly_con,\n                  'W' => pwell })\n\n# nmos - HV\nlogger.info('Extraction of NMOS-HV transistor')\nextract_devices(mos4('sg13_hv_nmos'),\n                { 'SD' => nsd_fet,\n                  'G' => ngate_hv,\n                  'tS' => nsd_fet,\n                  'tD' => nsd_fet,\n                  'tG' => poly_con,\n                  'W' => pwell })\n\n# ==============\n# ---- PMOS ----\n# ==============\n\nlogger.info('Starting PMOS EXTRACTION')\n\n# pmos - LV\nlogger.info('Extraction of PMOS-LV transistor')\nextract_devices(mos4('sg13_lv_pmos'),\n                { 'SD' => psd_fet,\n                  'G' => pgate_lv,\n                  'tS' => psd_fet,\n                  'tD' => psd_fet,\n                  'tG' => poly_con,\n                  'W' => nwell_drw })\n\n# pmos - HV\nlogger.info('Extraction of PMOS-HV transistor')\nextract_devices(mos4('sg13_hv_pmos'),\n                { 'SD' => psd_fet,\n                  'G' => pgate_hv,\n                  'tS' => psd_fet,"
    },
    {
      "path": "libs.tech/klayout/tech/lvs/rule_decks/custom_reader.lvs",
      "sha256": "8100bf1192b3d20538839dd888df95a8453127cc49ffc177cab3ac67cde18b29",
      "first_line": 375,
      "last_line": 382,
      "text": "  # Create MOS4 device class.\n  def create_mos\n    mos_class = RBA::DeviceClassMOS4Transistor.new\n    mos_class.add_parameter(RBA::DeviceParameterDefinition.new('rfmode', 'rf mode', 0, true))\n    mos_class\n  end\n\n  # Create a capacitor device class."
    },
    {
      "path": "libs.tech/klayout/tech/lvs/rule_decks/custom_writer.lvs",
      "sha256": "bada63cfda80316f64ffbd1f6ed2a9cc06cd337b7244fe7d608ae4a20dfc0c36",
      "first_line": 101,
      "last_line": 121,
      "text": "\n  # Generate default parameters for the device\n  def generate_default_parameters(device, device_class)\n    parameters = device_class.parameter_definitions.map do |pd|\n      next if pd.name.to_s.casecmp('rfmode').zero?\n\n      value = format_parameter_value(pd.name, device.parameter(pd.id))\n      next if value.nil?\n\n      unit = get_unit(pd.name)\n      if unit.empty?\n        format('%<name>s=%<value>.12g', name: pd.name, value: value)\n      else\n        format('%<name>s=%<value>.12g%<unit>s', name: pd.name, value: value, unit: unit)\n      end\n    end\n    # Use compact to remove any nil values\n    parameters.compact.join(' ')\n  end\n\n  def format_parameter_value(name, value)"
    },
    {
      "path": "libs.tech/klayout/tech/lvs/sg13g2.lvs",
      "sha256": "ea1b690ce0f4b9d77d84fa91a913a048b4e14f1da4889a41ae03ca9fe9bfba43",
      "first_line": 447,
      "last_line": 457,
      "text": "\napply_netlist_options = lambda do |target_netlist, label|\n  log_option_action.call(label, 'simplify', SIMPLIFY)\n  target_netlist.simplify if SIMPLIFY\n\n  log_option_action.call(label, 'make_top_level_pins', TOP_LVL_PINS)\n  target_netlist.make_top_level_pins if TOP_LVL_PINS\n\n  log_option_action.call(label, 'combine_devices', COMBINE_DEVICES)\n  target_netlist.combine_devices if COMBINE_DEVICES\n"
    }
  ],
